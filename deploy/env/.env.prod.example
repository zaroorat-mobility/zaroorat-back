# ==============================================================================
# ZAROORAT MOBILITY — PRODUCTION ENVIRONMENT TEMPLATE (.env.prod.example)
# ==============================================================================

# --- 1. APPLICATION & SERVER IDENTITY ---
APP_NAME=zaroorat-backend
APP_ENV=prod
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
API_SHUTDOWN_DRAIN_MS=10000
API_SHUTDOWN_GRACE_MS=25000
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=3001
WORKER_SHUTDOWN_GRACE_MS=30000
CADDY_DOMAIN=api.zaroorat.com

# --- 2. DATABASE CONFIGURATION (PostgreSQL / PostGIS / PgBouncer) ---
POSTGRES_USER=zaroorat
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
POSTGRES_DB=zaroorat_prod
APP_DB_USER=zaroorat_app
APP_DB_PASSWORD=REPLACE_WITH_APP_DB_PASSWORD
DATABASE_URL=postgresql://zaroorat_app:REPLACE_WITH_APP_DB_PASSWORD@pgbouncer:6432/zaroorat_prod
MIGRATION_DATABASE_URL=postgresql://zaroorat:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/zaroorat_prod
DB_SSL_MODE=disable
DB_SSL_ROOT_CERT=
DB_SSL_CA=
DB_POOL_MIN=10
DB_POOL_MAX=50
DB_POOL_CONNECTION_TIMEOUT=5000
DB_POOL_IDLE_TIMEOUT=30000
DB_BOOT_RETRIES=10
DB_BOOT_RETRY_DELAY_MS=500
DB_SLOW_QUERY_MS=1000

# --- 3. CACHE & REALTIME (Valkey 8.1 / Redis & Socket.IO) ---
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@valkey:6379
REALTIME_ADAPTER=redis
REALTIME_ENABLED=true
REALTIME_PATH=/socket.io
REALTIME_CORS_ORIGINS=https://admin.zaroorat.com,https://zaroorat.com
REALTIME_PING_INTERVAL_MS=25000
REALTIME_PING_TIMEOUT_MS=20000
REALTIME_MAX_PAYLOAD_BYTES=8192
REALTIME_LOCATION_MIN_INTERVAL_MS=1000
REALTIME_LOCATION_PERSIST_INTERVAL_MS=5000
REALTIME_LOCATION_MAX_AGE_MS=30000

# --- 4. SESSION MANAGEMENT ---
SESSION_DENYLIST_TTL=2592000
SESSION_LAST_SEEN_THROTTLE=60
SESSION_MAX_CONCURRENT=5
SESSION_MAX_CONCURRENT_PRIVILEGED=1

# --- 5. SECURITY & CRYPTOGRAPHY ---
JWT_ACCESS_SECRET=REPLACE_WITH_32_HEX_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_32_HEX_REFRESH_SECRET
JWT_ISSUER=zaroorat-backend
JWT_PRIMARY_KID=primary
JWT_ACCESS_TTL_SECONDS=900
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_TTL_SECONDS=2592000
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_RETENTION_DAYS=90
ENCRYPTION_KEY=REPLACE_WITH_32_HEX_ENCRYPTION_KEY
RIDE_PIN_PEPPER=REPLACE_WITH_32_HEX_RIDE_PIN_PEPPER
BANK_DATA_ENCRYPTION_KEY=REPLACE_WITH_32_HEX_BANK_KEY
BANK_ACCOUNT_HASH_KEY=REPLACE_WITH_32_HEX_BANK_HASH
OTP_PEPPER=REPLACE_WITH_32_HEX_OTP_PEPPER
RATE_LIMIT_BYPASS=false

# --- 6. NETWORK, PROXY & CORS ---
TRUSTED_PROXIES=172.30.0.0/24
CORS_ALLOWED_ORIGINS=https://admin.zaroorat.com,https://zaroorat.com

# --- 7. OBJECT STORAGE (AWS S3 - ap-south-1) ---
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=zaroorat-production-storage
STORAGE_QUARANTINE_BUCKET=zaroorat-production-quarantine
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_MALWARE_SCANNER=guardduty
STORAGE_SSE=aws:kms
STORAGE_KMS_KEY_ID=arn:aws:kms:ap-south-1:123456789012:key/REPLACE_ME
STORAGE_FORCE_PATH_STYLE=false
STORAGE_UPLOAD_TTL_SEC=900
STORAGE_MAX_RETRIES=3
STORAGE_TIMEOUT_MS=10000

# --- 8. SMS & TELECOMMUNICATIONS (Airtel DLT & Exotel) ---
SMS_PROVIDER=airtel
SMS_TIMEOUT_MS=5000
AIRTEL_API_URL=https://digimate.airtel.in/smsgateway/message
AIRTEL_CUSTOMER_ID=REPLACE_WITH_AIRTEL_CUSTOMER_ID
AIRTEL_API_KEY=REPLACE_WITH_AIRTEL_API_KEY
AIRTEL_USERNAME=REPLACE_WITH_AIRTEL_USERNAME
AIRTEL_PASSWORD=REPLACE_WITH_AIRTEL_PASSWORD
AIRTEL_SENDER_ID=ZAROOR
AIRTEL_ENTITY_ID=1001000000000000001
AIRTEL_OTP_TEMPLATE_ID=1007000000000000001
AIRTEL_CUSTOMER_OTP_TEMPLATE_ID=1007000000000000001
AIRTEL_CUSTOMER_OTP_MESSAGE="Your Zaroorat verification code is {otp}."
AIRTEL_DRIVER_OTP_TEMPLATE_ID=1007000000000000002
AIRTEL_DRIVER_OTP_MESSAGE="Your Zaroorat Driver login code is {otp}."
AIRTEL_DRIVER_ACTIVATED_TEMPLATE_ID=1007000000000000003
AIRTEL_DRIVER_ACTIVATED_MESSAGE="Your Zaroorat driver account is now active."
AIRTEL_DRIVER_APPLICATION_REJECTED_TEMPLATE_ID=1007000000000000004
AIRTEL_DRIVER_APPLICATION_REJECTED_MESSAGE="Your driver application could not be approved."
AIRTEL_DRIVER_DOC_REJECTED_TEMPLATE_ID=1007000000000000005
AIRTEL_DRIVER_DOC_REJECTED_MESSAGE="Your document was rejected. Please re-upload in the app."

CALL_PROVIDER=exotel
EXOTEL_VIRTUAL_NUMBER=+918000000000

# --- 9. OTP POLICIES & DELIVERY RULES ---
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_INTERVAL_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=3
OTP_LOCKOUT_SECONDS=900
OTP_LIMIT_PHONE=5
OTP_LIMIT_IP=20
OTP_LIMIT_DEVICE=10
OTP_WINDOW_PHONE=3600
OTP_WINDOW_IP=3600
OTP_WINDOW_DEVICE=3600
OTP_TRAIL_RETENTION_DAYS=180
OTP_DELIVERY_ATTEMPTS=3
OTP_DELIVERY_BACKOFF_MS=1000
OTP_WORKER_CONCURRENCY=5

# --- 10. PUSH NOTIFICATIONS (Firebase Cloud Messaging) ---
PUSH_PROVIDER=fcm
FIREBASE_SERVICE_ACCOUNT_JSON=REPLACE_WITH_SINGLE_LINE_JSON
FCM_SERVER_KEY=

# --- 11. EMAIL NOTIFICATIONS (SMTP) ---
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@zaroorat.com
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=REPLACE_WITH_SENDGRID_KEY

# --- 12. MAPS & GEOLOCATION SERVICES ---
MAP_PROVIDER=mappls
ALLOW_OFFLINE_ROUTING=false
ENABLE_OFFLINE_ROUTING=false
MAPS_API_KEY=REPLACE_WITH_MAPS_KEY
MAPPLS_BASE_URL=https://apis.mappls.com/advancedmaps/v1
MAPPLS_CLIENT_ID=REPLACE_WITH_MAPPLS_CLIENT_ID
MAPPLS_CLIENT_SECRET=REPLACE_WITH_MAPPLS_CLIENT_SECRET
MAPPLS_REST_API_KEY=REPLACE_WITH_MAPPLS_REST_KEY
MAPPLS_CLIENT_SDK_KEY=REPLACE_WITH_MAPPLS_SDK_KEY
MAPPLS_TILE_LAYER=standard
GOOGLE_MAPS_API_KEY=REPLACE_WITH_GOOGLE_MAPS_KEY
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com/maps/api
GOOGLE_MAPS_CLIENT_SDK_KEY=REPLACE_WITH_GOOGLE_SDK_KEY
OLA_MAPS_API_KEY=REPLACE_WITH_OLA_KEY
OLA_MAPS_BASE_URL=https://api.olamaps.io
OLA_MAPS_CLIENT_SDK_KEY=REPLACE_WITH_OLA_SDK_KEY

GEO_H3_RESOLUTION=8
GEO_SEARCH_RADIUS_M=5000
GEO_MAX_SEARCH_RADIUS_M=15000
GEO_MAX_CANDIDATES=10
GEO_CANDIDATE_STALENESS_SEC=60
GEO_LIVE_LOCATION_TTL_SEC=30
GEO_RIDE_LOCATION_SAMPLE_INTERVAL_MS=5000
GEO_RIDE_LOCATION_RETENTION_DAYS=90
GEO_ETA_REFRESH_MIN_INTERVAL_MS=30000
GEO_ETA_REFRESH_MAX_INTERVAL_MS=120000
GEO_ETA_REFRESH_MIN_MOVEMENT_M=200

# --- 13. PAYMENT GATEWAYS (Razorpay Live) ---
PAYMENT_DEFAULT_GATEWAY=razorpay
PAYMENT_DEFAULT_CURRENCY=INR
PAYMENT_CASH_CONFIRMATION_REQUIRED=true
RAZORPAY_ENVIRONMENT=live
RAZORPAY_KEY_ID=rzp_live_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_LIVE_SECRET
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_LIVE_WEBHOOK_SECRET
STRIPE_SECRET_KEY=
PAYMENT_LEDGER_CUTOVER_AT=

# --- 14. DRIVER OPERATIONS & TELEMETRY ---
DRIVER_LOCATION_MAX_AGE_SEC=30
DRIVER_LOCATION_MAX_SPEED_KMH=140
DRIVER_LOCATION_NOISE_FLOOR_M=5
DRIVER_LOCATION_STALE_BASELINE_SEC=120
DRIVER_REJECT_MOCK_LOCATION=true
DRIVER_MAX_SHIFT_HOURS=12
DRIVER_HEARTBEAT_TIMEOUT_SECONDS=90
DRIVER_REQUIRE_APPROVED_DOCS=true
DRIVER_REQUIRED_DOCUMENT_TYPES=DRIVING_LICENSE,RC,INSURANCE

# --- 15. VEHICLE COMPLIANCE ---
VEHICLE_REQUIRE_APPROVED_DOCS=true
VEHICLE_REQUIRE_VERIFIED=true
VEHICLE_REQUIRED_DOCUMENT_TYPES=VEHICLE_RC,VEHICLE_INSURANCE,VEHICLE_PERMIT,VEHICLE_FITNESS

# --- 16. USER, SAFETY & IDENTITY POLICIES ---
USER_MIN_AGE_YEARS=18
USER_MAX_EMERGENCY_CONTACTS=5
USER_MAX_SAVED_PLACES=10
USER_PHONE_CHANGE_LIMIT=1
USER_PHONE_CHANGE_WINDOW_SEC=2592000
USER_SUPPORTED_LANGUAGES=en,hi,bn,te,mr,ta,ur,gu,kn,ml,pa,or
USER_DELETION_RETENTION_DAYS=30
USER_ERASURE_BATCH=50
DEFAULT_USER_ROLE=customer

# --- 17. FILE UPLOAD LIMITS & QUOTAS (Bytes) ---
FILE_MAX_PROFILE_IMAGE_BYTES=5242880
FILE_MAX_DRIVER_DOCUMENT_BYTES=10485760
FILE_MAX_VEHICLE_DOCUMENT_BYTES=10485760
FILE_MAX_VEHICLE_IMAGE_BYTES=5242880
FILE_MAX_DISPUTE_EVIDENCE_BYTES=10485760
FILE_MAX_SOS_EVIDENCE_BYTES=20971520
FILE_MAX_PROMO_BANNER_BYTES=5242880
FILE_QUOTA_USER_BYTES=104857600
FILE_QUOTA_DAILY_BYTES=52428800
FILE_QUOTA_PURPOSE_BYTES=31457280
FILE_UPLOADS_PER_HOUR=20
FILE_UPLOADS_PER_PURPOSE_PER_HOUR=5
FILE_READ_URLS_PER_MINUTE=60
FILE_IMAGE_PEEK_BYTES=24
FILE_PEEK_BYTES=4096
FILE_JOB_MAX_ATTEMPTS=3

# --- 18. SCHEDULED BACKGROUND CRON JOBS ---
AUTH_RETENTION_CRON="0 3 * * *"
DRIVER_HEARTBEAT_CRON="* * * * *"
DRIVER_DOC_EXPIRATION_CRON="0 0 * * *"
DRIVER_SETTLEMENT_CRON="0 1 * * *"
FILE_SWEEPER_CRON="0 3 * * *"
FILE_SWEEPER_BATCH=100
FILE_RETENTION_CRON="0 4 * * 0"
FILE_RETENTION_BATCH=500
NOTIFICATION_RECONCILIATION_CRON="0 */4 * * *"
NOTIFICATION_EVENT_RECONCILIATION_CRON="0 3 * * *"
NOTIFICATION_EVENT_RECONCILIATION_MODE=soft
PAYMENT_RECONCILIATION_CRON="0 2 * * *"
PAYMENT_INTENT_RECONCILIATION_CRON="*/15 * * * *"
PAYMENT_COLLECTION_SWEEP_CRON="0 3 * * *"
PAYMENT_RECEIVABLE_WRITEOFF_CRON="0 4 1 * *"
REFUND_RECONCILIATION_CRON="0 5 * * *"
REFERRAL_PENDING_REWARD_SWEEP_CRON="0 2 * * *"
RIDE_DISPATCH_TIMEOUT_CRON="* * * * *"
RIDE_REQUEST_EXPIRY_CRON="*/2 * * * *"
RIDE_REQUEST_IDEMPOTENCY_TTL_SECONDS=30
SCHEDULED_RIDE_REMINDER_CRON="*/5 * * * *"
SUBSCRIPTION_EXPIRY_CRON="0 0 * * *"
USER_ERASURE_CRON="0 2 * * *"
IDEMPOTENCY_TTL_SECONDS=120
RIDE_SHARE_BASE_URL=https://zaroorat.com/ride

# --- 19. RATE LIMITING POLICIES (Limit, Window in Seconds) ---
RL_OTP_SEND_LIMIT=3
RL_OTP_SEND_WINDOW=600
RL_OTP_VERIFY_LIMIT=5
RL_OTP_VERIFY_WINDOW=600
RL_ADMIN_LOGIN_LIMIT=5
RL_ADMIN_LOGIN_WINDOW=900
RL_REFRESH_LIMIT=30
RL_REFRESH_WINDOW=300
RL_RIDE_WRITE_LIMIT=20
RL_RIDE_WRITE_WINDOW=60
RL_DRIVER_LOCATION_LIMIT=60
RL_DRIVER_LOCATION_WINDOW=60
RL_DRIVER_MAP_ZONES_LIMIT=30
RL_DRIVER_MAP_ZONES_WINDOW=60
RL_RIDER_SERVICEABILITY_LIMIT=60
RL_RIDER_SERVICEABILITY_WINDOW=60
RL_MAPS_SEARCH_LIMIT=60
RL_MAPS_SEARCH_WINDOW=60
RL_MAPS_ROUTE_LIMIT=30
RL_MAPS_ROUTE_WINDOW=60
RL_FILE_UPLOAD_LIMIT=10
RL_FILE_UPLOAD_WINDOW=60
RL_SUPPORT_WRITE_LIMIT=10
RL_SUPPORT_WRITE_WINDOW=60
RL_PAYMENT_LIMIT=20
RL_PAYMENT_WINDOW=60
RL_PAYMENT_STATUS_LIMIT=60
RL_PAYMENT_STATUS_WINDOW=60
RL_APP_CONFIG_LIMIT=120
RL_APP_CONFIG_WINDOW=60
RL_RIDE_SHARE_VIEW_LIMIT=60
RL_RIDE_SHARE_VIEW_WINDOW=60
RL_WEBHOOK_LIMIT=120
RL_WEBHOOK_WINDOW=60
