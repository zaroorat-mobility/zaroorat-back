{$CADDY_DOMAIN:dev-api.zaroorat.com} {
    encode gzip zstd

    @blocked path /metrics /docs /docs/*
    respond @blocked 404

    reverse_proxy api:3000 {
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    log {
        output stdout
        format json
    }
}
