APP_ENV=test
NODE_ENV=test

APP_NAME=zaroorat-backend
HOST=127.0.0.1
PORT=3001

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zaroorat_test

REDIS_URL=redis://localhost:6379/1

# EnvironmentSchema requires >= 32 characters. Test-only values, never real secrets.
JWT_ACCESS_SECRET=test_access_secret_padded_to_min_32_chars
JWT_REFRESH_SECRET=test_refresh_secret_padded_to_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
