# Never ship the build context we don't need — smaller context, faster builds,
# and no chance of baking secrets or host node_modules into an image.
node_modules
dist
coverage
tsconfig.tsbuildinfo

.git
.github
.husky
.vscode
.idea

# Secrets — only .env.example is safe, and even that isn't needed at build time.
.env
.env.*

docs
tests
observability
infrastructure

# scripts/ is NOT excluded: `npm run build` runs scripts/copy-generated.js.

# The Prisma client is generated inside the image (22MB of engines otherwise
# shipped through the build context on every build).
src/generated

*.log
.DS_Store
Dockerfile
.dockerignore
docker-compose.yml
README.md
CONTRIBUTING.md
LICENSE
