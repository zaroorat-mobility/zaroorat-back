# ─────────────────────────────────────────────────────────────
# Application-level variables, read by src/config/env/schema.ts
# and the per-module configs under src/config/.
#
# Loading rules (src/config/env/loader.ts):
#   APP_ENV=development -> .env.development MUST exist or startup throws
#   APP_ENV=test        -> .env.test MUST exist or startup throws
#   APP_ENV=production  -> NO file is loaded; inject real variables instead
# Already-set process environment always wins over the file (override: false).
#
# compose.prod.yml additionally needs these on the HOST shell — they configure
# the datastore containers, not the app, and must never be committed:
#   POSTGRES_PASSWORD  REDIS_PASSWORD  JWT_ACCESS_SECRET  JWT_REFRESH_SECRET
# Optional: POSTGRES_USER, POSTGRES_DB, API_PORT, IMAGE_TAG, DB_SSL_MODE
# ─────────────────────────────────────────────────────────────

# Application
APP_NAME=zaroorat-backend
APP_ENV=development
HOST=0.0.0.0
PORT=3000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Redis
REDIS_URL=redis://HOST:6379

# Authentication
# Both secrets must be at least 32 characters or boot-time validation fails.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_me_with_a_32_char_minimum_secret
JWT_REFRESH_SECRET=replace_me_with_a_32_char_minimum_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Storage (files doc 08 section 2)
# `mock` is an in-process store and loses every object on restart; it is the
# default in development and test only. Selecting `s3` without a bucket fails at
# boot rather than falling back.
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
# Uploads land here until they are scanned and validated. Must be set, and must
# differ from STORAGE_BUCKET — that separation is what stops an unscanned object
# being readable. Boot fails without it when STORAGE_PROVIDER=s3.
STORAGE_QUARANTINE_BUCKET=
# `guardduty` or `disabled`. Defaults to guardduty in production and staging,
# where `disabled` is refused at boot. GuardDuty additionally requires
# STORAGE_SSE=aws:kms with a dedicated STORAGE_KMS_KEY_ID.
STORAGE_MALWARE_SCANNER=
STORAGE_REGION=ap-south-1
# Leave both blank to use the instance role.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Set for MinIO / R2 / Spaces, which are S3 with a different endpoint.
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false
# AES256 or aws:kms. Never unencrypted.
STORAGE_SSE=AES256
STORAGE_KMS_KEY_ID=

# Background jobs (files doc 08 section 6)
# Read by `src/jobs/scheduler`, which runs in the worker process (`npm run
# worker`), not the API. Both patterns are interpreted in UTC regardless of the
# host clock — 03:00 UTC is 08:30 IST.
FILE_SWEEPER_CRON=*/15 * * * *
FILE_RETENTION_CRON=0 3 * * *
# Account erasure runs half an hour after FILES' retention, not alongside it:
# it hands its avatar to FILES, and running them together would have one job's
# output land after the other had already scanned for it.
USER_ERASURE_CRON=30 3 * * *
USER_DELETION_RETENTION_DAYS=30

# Maps & Location Provider Settings
MAP_PROVIDER=ola

# Ola Maps
OLA_MAPS_API_KEY=
OLA_MAPS_BASE_URL=https://api.olamaps.io

# Google Maps
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com

# Mappls (MapmyIndia)
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
MAPPLS_REST_API_KEY=
MAPPLS_BASE_URL=https://route.mappls.com/route/direction

# Payments
# `mock` is an in-process gateway and moves no real money; it is the default in
# development and test only. Staging and production default to `razorpay`.
PAYMENT_DEFAULT_GATEWAY=razorpay
PAYMENT_API_KEY=
# REQUIRED whenever PAYMENT_DEFAULT_GATEWAY is a live gateway (razorpay/stripe).
# Boot FAILS if it is missing or blank — there is no built-in fallback, because
# verifying live signatures against a committed constant lets anyone holding
# this source forge `payment.succeeded`. Only the `mock` gateway may run without
# one. Take the value from the gateway dashboard's webhook settings.
PAYMENT_WEBHOOK_SECRET=
# How far in the past a signed webhook timestamp may be before it is treated as
# a replay (seconds).
PAYMENT_WEBHOOK_TOLERANCE_SEC=300

# --- Payments: collection, receivables & cash (feature 002) ---
# Every value below is validated at boot via numericEnv; a typo stops the
# process rather than yielding NaN, which would defeat every downstream guard.

# BD-4 — bounded collection retry. No combination may produce an unbounded
# loop, which is why the attempt cap carries a maximum. Bounds: 1-20 (int).
PAYMENT_COLLECTION_MAX_ATTEMPTS=5
# BD-4 — base interval for the decaying retry schedule. Bounds: 30-86400 (int).
PAYMENT_COLLECTION_RETRY_BASE_SEC=300

# BD-2 — outstanding-receivable threshold. A rider at or above this figure
# cannot create a NEW ride request; settling an existing one is never blocked.
# Comparison is >= (reaches or exceeds). Bounds: >= 0.
PAYMENT_RIDER_DEBT_LIMIT=500

# BD-5 — cash confirmation rollout. DEFAULT OFF, deliberately: this knob reads
# `=== 'true'`, unlike the project's usual `!== 'false'` idiom, because the
# approved decision requires OFF by default. While disabled the confirm-cash
# route is NOT REGISTERED and cash rides behave exactly as they do today.
# Enable only once the driver app can call it.
PAYMENT_CASH_CONFIRMATION_REQUIRED=false
# BD-6 — grace period after which an unconfirmed cash ride resolves
# automatically. Without it, never confirming would let a driver keep the cash
# and avoid the commission. Bounds: >= 60 (int).
PAYMENT_CASH_CONFIRM_GRACE_SEC=3600

# BD-1c — ageing period after which an outstanding receivable is written off
# to BAD_DEBT_EXPENSE. Deliberately not hard-coded. Bounds: >= 1 (int).
PAYMENT_RECEIVABLE_WRITEOFF_DAYS=90

# BD-7 — prospective-only ledger correction boundary (ISO-8601). Reconciliation
# scopes its live comparison to entries at or after this instant; earlier
# entries are reported separately as historical and are NEVER rewritten.
# Leave blank to cut over from process start.
PAYMENT_LEDGER_CUTOVER_AT=

# Notifications
FCM_PROJECT_ID=

# Push delivery
# `mock` is the only implementation that exists: it accepts every message and
# drops it. Staging and production REFUSE TO BOOT on it, because a dispatch
# offer that never reaches a backgrounded driver expires unanswered while the
# customer waits. There is no override and no other value to set yet — a real
# provider has to be implemented behind `createPushProvider` first, the way
# Msg91Provider sits behind `createSmsProvider`.
PUSH_PROVIDER=

# SMS / OTP delivery
# `mock` accepts every message and delivers nothing; it is the default in
# development and test. Staging and production default to `msg91`. Setting this
# explicitly OVERRIDES that default in every environment — SMS_PROVIDER=mock in
# production means no customer ever receives a code.
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
# REQUIRED for msg91: it is a template-only API and refuses a send without one.
MSG91_OTP_TEMPLATE_ID=
# Caps a single gateway call. Delivery runs in the worker, so this bounds how
# long one job holds a slot, not how long the customer waits.
SMS_TIMEOUT_MS=5000

# OTP (src/config/otp/otp.config.ts)
# OTP_PEPPER is derived from JWT_REFRESH_SECRET when unset — which means rotating
# that secret silently invalidates every OTP in flight. Set it explicitly.
OTP_PEPPER=
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=900
OTP_RESEND_INTERVAL_SECONDS=60
OTP_TRAIL_RETENTION_DAYS=30
# Delivery retries, applied by BullMQ in the worker. The total retry budget must
# stay comfortably inside OTP_TTL_SECONDS: a code that lands after it expires is
# worse than one that never lands.
OTP_DELIVERY_ATTEMPTS=3
OTP_DELIVERY_BACKOFF_MS=2000
# Per-phone / per-device / per-IP send budgets.
OTP_LIMIT_PHONE=3
OTP_WINDOW_PHONE=3600
OTP_LIMIT_DEVICE=5
OTP_WINDOW_DEVICE=3600
OTP_LIMIT_IP=20
OTP_WINDOW_IP=3600

# Worker process (npm run worker / node dist/worker.js)
# Runs every BullMQ queue: scheduled maintenance AND OTP SMS delivery. Without a
# worker deployed, OTPs are generated and queued but never sent.
WORKER_HEALTH_HOST=0.0.0.0
# Probes only — never expose this port publicly.
WORKER_HEALTH_PORT=3001
OTP_WORKER_CONCURRENCY=20
# Must stay below the pod's terminationGracePeriodSeconds.
WORKER_SHUTDOWN_GRACE_MS=120000

# Dispatch (ride offers)
# Every value here is validated at boot: a non-numeric, zero or out-of-range
# setting stops the process rather than being coerced to NaN. Delete a line to
# take the default shown.
# How long a driver has to answer an offer before it times out.
RIDE_DISPATCH_TIMEOUT_SEC=10
# How many drivers may hold an offer for ONE request at the same time. This is a
# ceiling, not a per-round increment: as offers are rejected or time out, the
# next round tops back up to this number. 1 restores strictly sequential
# dispatch. Bounded to 1..20.
RIDE_DISPATCH_BATCH_SIZE=3
# How long a request keeps searching before it is abandoned. This is also what
# bounds the number of dispatch rounds — there is no separate round cap.
RIDE_REQUEST_EXPIRY_MIN=5
# Cron for the job that expires offers and re-dispatches. Note it runs at most
# once a minute, so an offer can sit expired for up to a minute before the sweep
# notices; an explicit driver reject re-dispatches immediately instead.
RIDE_DISPATCH_TIMEOUT_CRON=* * * * *
RIDE_REQUEST_EXPIRY_CRON=* * * * *

# How far above the accepted quote the final fare may land, as a percentage.
# The bill is recomputed from measured distance and duration, so without this a
# trip delayed in traffic costs more than the customer agreed to, unbounded.
# 0 makes the quote binding. The cap never applies downward — billing a shorter
# trip for less is not a promise being broken — and the platform absorbs the
# capped amount rather than the driver.
RIDE_MAX_FARE_INCREASE_OVER_QUOTE_PCT=10

# Real-time (Socket.IO)
# Sockets share the API's HTTP port; there is no separate listener.
REALTIME_ENABLED=true
REALTIME_PATH=/socket.io
# Comma-separated. Defaults to the production web origins when APP_ENV=production
# and to "any origin" otherwise.
# REALTIME_CORS_ORIGINS=https://zaroorat.com,https://admin.zaroorat.com
REALTIME_PING_INTERVAL_MS=25000
REALTIME_PING_TIMEOUT_MS=20000
REALTIME_MAX_PAYLOAD_BYTES=8192
# Backpressure on driver.location.update: frames arriving faster than this are
# dropped, not queued.
REALTIME_LOCATION_MIN_INTERVAL_MS=1000
# How often an accepted frame is written through to driver_locations and the
# Redis GEO index. Between writes the frame is still broadcast to the ride room.
REALTIME_LOCATION_PERSIST_INTERVAL_MS=5000
# Frames older (or more future-dated) than this are refused as stale.
REALTIME_LOCATION_MAX_AGE_MS=30000
# 'memory' is the ONLY implemented adapter and is correct for a SINGLE API
# instance. Rooms are process-local: with two instances, a client connected to
# one never sees an emit made on the other. Setting this to 'redis' currently
# FAILS AT BOOT by design — @socket.io/redis-adapter is not installed or wired.
# Do not scale the API horizontally until that is done.
REALTIME_ADAPTER=memory
