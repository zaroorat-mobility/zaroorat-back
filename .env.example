# Application
APP_NAME=zaroorat-backend
APP_ENV=development
HOST=0.0.0.0
PORT=3000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Redis
REDIS_URL=redis://HOST:6379

# Authentication
# Both secrets must be at least 32 characters or boot-time validation fails.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_me_with_a_32_char_minimum_secret
JWT_REFRESH_SECRET=replace_me_with_a_32_char_minimum_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Storage (files doc 08 section 2)
# `mock` is an in-process store and loses every object on restart; it is the
# default in development and test only. Selecting `s3` without a bucket fails at
# boot rather than falling back.
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=ap-south-1
# Leave both blank to use the instance role.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Set for MinIO / R2 / Spaces, which are S3 with a different endpoint.
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false
# AES256 or aws:kms. Never unencrypted.
STORAGE_SSE=AES256
STORAGE_KMS_KEY_ID=

# Maps
MAPS_API_KEY=

# Payments
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Notifications
FCM_PROJECT_ID=
