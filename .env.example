# Application
APP_NAME=zaroorat-backend
APP_ENV=development
HOST=0.0.0.0
PORT=3000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Redis
REDIS_URL=redis://HOST:6379

# Authentication
# Both secrets must be at least 32 characters or boot-time validation fails.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_me_with_a_32_char_minimum_secret
JWT_REFRESH_SECRET=replace_me_with_a_32_char_minimum_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Storage (files doc 08 section 2)
# `mock` is an in-process store and loses every object on restart; it is the
# default in development and test only. Selecting `s3` without a bucket fails at
# boot rather than falling back.
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=ap-south-1
# Leave both blank to use the instance role.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Set for MinIO / R2 / Spaces, which are S3 with a different endpoint.
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false
# AES256 or aws:kms. Never unencrypted.
STORAGE_SSE=AES256
STORAGE_KMS_KEY_ID=

# Background jobs (files doc 08 section 6)
# Read by `src/jobs/scheduler`, which runs in the worker process (`npm run
# worker`), not the API. Both patterns are interpreted in UTC regardless of the
# host clock — 03:00 UTC is 08:30 IST.
FILE_SWEEPER_CRON=*/15 * * * *
FILE_RETENTION_CRON=0 3 * * *
# Account erasure runs half an hour after FILES' retention, not alongside it:
# it hands its avatar to FILES, and running them together would have one job's
# output land after the other had already scanned for it.
USER_ERASURE_CRON=30 3 * * *
USER_DELETION_RETENTION_DAYS=30

# Maps
MAPS_API_KEY=

# Payments
# `mock` is an in-process gateway and moves no real money; it is the default in
# development and test only. Staging and production default to `razorpay`.
PAYMENT_DEFAULT_GATEWAY=razorpay
PAYMENT_API_KEY=
# REQUIRED whenever PAYMENT_DEFAULT_GATEWAY is a live gateway (razorpay/stripe).
# Boot FAILS if it is missing or blank — there is no built-in fallback, because
# verifying live signatures against a committed constant lets anyone holding
# this source forge `payment.succeeded`. Only the `mock` gateway may run without
# one. Take the value from the gateway dashboard's webhook settings.
PAYMENT_WEBHOOK_SECRET=
# How far in the past a signed webhook timestamp may be before it is treated as
# a replay (seconds).
PAYMENT_WEBHOOK_TOLERANCE_SEC=300

# Notifications
FCM_PROJECT_ID=
