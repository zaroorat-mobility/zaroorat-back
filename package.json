{
  "name": "backend_zaroorat",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "npm run clean && tsc --project tsconfig.json && tsc-alias --project tsconfig.json && node scripts/copy-generated.js",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "test": "cross-env APP_ENV=test tsx --test --test-concurrency=1 --test-force-exit \"tests/**/*.test.ts\"",
    "test:watch": "cross-env APP_ENV=test tsx --test --watch \"tests/**/*.test.ts\"",
    "test:unit": "cross-env APP_ENV=test tsx --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "cross-env APP_ENV=test tsx --test --test-concurrency=1 --test-force-exit \"tests/integration/**/*.test.ts\"",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.tools.json",
    "prepare": "is-ci || husky",
    "preinstall": "npx -y only-allow npm",
    "postinstall": "prisma generate",
    "prisma:validate": "node scripts/validate-prisma.js",
    "prisma:format": "node scripts/format-prisma.js",
    "prisma:reset": "node scripts/reset-db.js",
    "prisma:generate": "npx prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@fastify/awilix": "^8.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "awilix": "^13.0.5",
    "bullmq": "^6.0.7",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/pino": "^7.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.1.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prisma": "^7.9.0",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "@prisma/engines@7.9.0": true,
    "esbuild@0.28.1": true,
    "prisma@7.9.0": true
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "overrides": {
    "find-my-way": "^9.6.1",
    "valibot": "^1.4.2"
  }
}
