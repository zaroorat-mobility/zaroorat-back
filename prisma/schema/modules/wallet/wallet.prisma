model WalletTopup {
  id                   String    @id @default(uuid(7)) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  walletId             String    @map("wallet_id") @db.Uuid
  amount               Decimal   @db.Decimal(12, 2)
  currency             String    @default("INR") @db.Char(3)
  paymentIntentId      String?   @map("payment_intent_id") @db.Uuid
  paymentTransactionId String?   @map("payment_transaction_id") @db.Uuid
  status               String    @default("PENDING")
  gateway              String?
  idempotencyKey       String    @unique @map("idempotency_key")
  createdAt            DateTime  @default(now()) @map("created_at")
  completedAt          DateTime? @map("completed_at")

  user   User           @relation(fields: [userId], references: [id])
  wallet CustomerWallet @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([userId])
  @@map("wallet_topups")
}

model WithdrawalRequest {
  id              String    @id @default(uuid(7)) @db.Uuid
  driverId        String    @map("driver_id") @db.Uuid
  walletId        String    @map("wallet_id") @db.Uuid
  bankAccountId   String?   @map("bank_account_id") @db.Uuid
  amount          Decimal   @db.Decimal(12, 2)
  status          String    @default("REQUESTED")
  payoutId        String?   @map("payout_id") @db.Uuid
  rejectionReason String?   @map("rejection_reason")
  requestedAt     DateTime  @default(now()) @map("requested_at")
  processedAt     DateTime? @map("processed_at")

  driver      Driver             @relation(fields: [driverId], references: [id])
  wallet      DriverWallet       @relation(fields: [walletId], references: [id])
  bankAccount DriverBankAccount? @relation(fields: [bankAccountId], references: [id])

  @@index([driverId])
  @@index([status])
  @@map("withdrawal_requests")
}

model WalletHold {
  id            String    @id @default(uuid(7)) @db.Uuid
  walletType    String    @map("wallet_type")
  walletId      String    @map("wallet_id") @db.Uuid
  ownerId       String    @map("owner_id") @db.Uuid
  amount        Decimal   @db.Decimal(12, 2)
  reason        String?
  status        String    @default("ACTIVE")
  referenceType String?   @map("reference_type")
  referenceId   String?   @map("reference_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  releasedAt    DateTime? @map("released_at")

  @@index([walletType, walletId])
  @@map("wallet_holds")
}

model WalletTransfer {
  id             String   @id @default(uuid(7)) @db.Uuid
  fromWalletType String   @map("from_wallet_type")
  fromWalletId   String?  @map("from_wallet_id") @db.Uuid
  toWalletType   String   @map("to_wallet_type")
  toWalletId     String?  @map("to_wallet_id") @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  reason         String?
  status         String   @default("COMPLETED")
  ledgerGroup    String?  @map("ledger_group") @db.Uuid
  idempotencyKey String   @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("wallet_transfers")
}

model CashbackCampaign {
  id           String   @id @default(uuid(7)) @db.Uuid
  code         String   @unique
  name         String?
  triggerEvent String   @map("trigger_event")
  rewardType   String   @map("reward_type")
  rewardValue  Decimal  @map("reward_value") @db.Decimal(10, 2)
  maxReward    Decimal? @map("max_reward") @db.Decimal(10, 2)
  minAmount    Decimal  @default(0) @map("min_amount") @db.Decimal(10, 2)
  totalBudget  Decimal? @map("total_budget") @db.Decimal(14, 2)
  usedBudget   Decimal  @default(0) @map("used_budget") @db.Decimal(14, 2)
  validFrom    DateTime @map("valid_from")
  validTo      DateTime @map("valid_to")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  grants CashbackGrant[]

  @@index([isActive, validFrom, validTo])
  @@map("cashback_campaigns")
}

model CashbackGrant {
  id         String    @id @default(uuid(7)) @db.Uuid
  campaignId String    @map("campaign_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  walletType String    @default("CUSTOMER") @map("wallet_type")
  walletId   String?   @map("wallet_id") @db.Uuid
  rideId     String?   @map("ride_id") @db.Uuid
  amount     Decimal   @db.Decimal(10, 2)
  status     String    @default("PENDING")
  grantedAt  DateTime  @default(now()) @map("granted_at")
  creditedAt DateTime? @map("credited_at")
  expiresAt  DateTime? @map("expires_at")

  campaign CashbackCampaign @relation(fields: [campaignId], references: [id])
  user     User             @relation(fields: [userId], references: [id])
  ride     Ride?            @relation(fields: [rideId], references: [id])

  @@index([campaignId])
  @@index([userId])
  @@map("cashback_grants")
}

model WalletAdjustment {
  id          String    @id @default(uuid(7)) @db.Uuid
  walletType  String    @map("wallet_type")
  walletId    String    @map("wallet_id") @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  direction   String // CREDIT | DEBIT
  amount      Decimal   @db.Decimal(12, 2)
  reason      String
  requestedBy String?   @map("requested_by") @db.Uuid
  approvedBy  String?   @map("approved_by") @db.Uuid
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now()) @map("created_at")
  appliedAt   DateTime? @map("applied_at")

  @@index([walletType, walletId])
  @@index([status])
  @@map("wallet_adjustments")
}

model WalletReconciliation {
  id              String   @id @default(uuid(7)) @db.Uuid
  walletType      String   @map("wallet_type")
  walletId        String   @map("wallet_id") @db.Uuid
  asOf            DateTime @map("as_of")
  storedBalance   Decimal  @map("stored_balance") @db.Decimal(14, 2)
  computedBalance Decimal  @map("computed_balance") @db.Decimal(14, 2)
  difference      Decimal  @db.Decimal(14, 2)
  status          String // MATCHED | MISMATCH
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([walletType, walletId, asOf])
  @@map("wallet_reconciliations")
}

/// 004-driver-subscription-wallet. A COMMISSION-model driver's manually-recharged
/// balance, used specifically to cover ride commission owed to the company.
/// Distinct from DriverWallet (earnings/payout, credited by settlement, the
/// opposite economic direction) and from CustomerWallet. No lockedBalance —
/// there is no reservation/freeze mechanism (spec.md FR-017a).
model DriverCommissionWallet {
  id                String    @id @default(uuid(7)) @db.Uuid
  driverId          String    @unique @map("driver_id") @db.Uuid
  balance           Decimal   @default(0) @db.Decimal(12, 2)
  currency          String    @default("INR") @db.Char(3)
  lastTransactionAt DateTime? @map("last_transaction_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  driver       Driver                              @relation(fields: [driverId], references: [id])
  transactions DriverCommissionWalletTransaction[]

  @@map("driver_commission_wallets")
}

/// Immutable per spec.md FR-013 — no correction ever edits a row here, only a
/// new, separate transaction. No expectedAmount/shortfall field: a
/// RIDE_COMMISSION row is written only when the FULL ride.commissionAmount is
/// deducted; when the wallet can't cover it, no row is written at all
/// (spec.md FR-024).
model DriverCommissionWalletTransaction {
  id            String   @id @default(uuid(7)) @db.Uuid
  walletId      String   @map("wallet_id") @db.Uuid
  driverId      String   @map("driver_id") @db.Uuid
  rideId        String?  @map("ride_id") @db.Uuid
  txnType       String   @map("txn_type") // MANUAL_RECHARGE | RIDE_COMMISSION | REFUND | ADMIN_CREDIT | ADMIN_DEBIT
  amount        Decimal  @db.Decimal(12, 2) // signed: credit positive, debit negative
  balanceAfter  Decimal  @map("balance_after") @db.Decimal(12, 2)
  referenceType String?  @map("reference_type") // 'RECHARGE' | 'RIDE' | 'ADMIN_ADJUSTMENT'
  referenceId   String?  @map("reference_id") @db.Uuid
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")

  wallet DriverCommissionWallet @relation(fields: [walletId], references: [id])
  ride   Ride?                  @relation(fields: [rideId], references: [id])

  settlementSteps   RideSettlementStep[]
  recoveredFailures CommissionCollectionFailure[]

  @@index([walletId, createdAt])
  @@index([driverId, createdAt])
  @@map("driver_commission_wallet_transactions")
}

/// Phase 4 (M-05): Atomic driver wallet reservation covering commission + GST recovery.
model DriverWalletReservation {
  id                  String    @id @default(uuid(7)) @db.Uuid
  rideId              String    @unique @map("ride_id") @db.Uuid
  driverId            String    @map("driver_id") @db.Uuid
  commissionAmount    Decimal   @default(0) @map("commission_amount") @db.Decimal(12, 2)
  gstRecoveryAmount   Decimal   @default(0) @map("gst_recovery_amount") @db.Decimal(12, 2)
  totalReservedAmount Decimal   @map("total_reserved_amount") @db.Decimal(12, 2)
  revision            Int       @default(1)
  status              String    @default("ACTIVE") // ACTIVE | CONSUMED | RELEASED
  createdAt           DateTime  @default(now()) @map("created_at")
  resolvedAt          DateTime? @map("resolved_at")

  ride   Ride   @relation(fields: [rideId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@index([driverId, status])
  @@map("driver_wallet_reservations")
}

/// Phase 4 (M-05): Per-ride financial settlement step tracker (G1, G2, G3).
/// Protected by DB trigger so POSTED steps are strictly immutable.
model RideSettlementStep {
  id            String   @id @default(uuid(7)) @db.Uuid
  rideId        String   @map("ride_id") @db.Uuid
  stepType      String   @map("step_type") // COMMISSION_DEBIT | PASSENGER_GST_LIABILITY | GST_RECOVERY_DEBIT
  status        String // POSTED | FAILED_INSUFFICIENT_BALANCE | WAIVED | SKIPPED_DISABLED | SKIPPED_GRANDFATHERED_SUBSCRIPTION | SKIPPED_DRIVER_LIABLE
  ledgerGroupId String?  @map("ledger_group_id") @db.Uuid
  walletTxnId   String?  @map("wallet_txn_id") @db.Uuid
  amount        Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  ride      Ride                               @relation(fields: [rideId], references: [id])
  walletTxn DriverCommissionWalletTransaction? @relation(fields: [walletTxnId], references: [id])

  @@unique([rideId, stepType])
  @@index([status, stepType])
  @@map("ride_settlement_steps")
}

/// Phase 4 (M-05, Rev 5 R5-6): Open & recovered settlement collection failures.
model CommissionCollectionFailure {
  id                    String    @id @default(uuid(7)) @db.Uuid
  rideId                String    @map("ride_id") @db.Uuid
  driverId              String    @map("driver_id") @db.Uuid
  kind                  String // COMMISSION | GST_RECOVERY
  amount                Decimal   @db.Decimal(12, 2)
  balanceAtAttempt      Decimal   @map("balance_at_attempt") @db.Decimal(12, 2)
  status                String    @default("OPEN") // OPEN | RECOVERED | WAIVED
  recoveryWalletTxnId   String?   @map("recovery_wallet_txn_id") @db.Uuid
  recoveryLedgerGroupId String?   @map("recovery_ledger_group_id") @db.Uuid
  waiverReason          String?   @map("waiver_reason")
  resolvedBy            String?   @map("resolved_by") @db.Uuid
  resolvedAt            DateTime? @map("resolved_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  ride              Ride                               @relation(fields: [rideId], references: [id])
  driver            Driver                             @relation(fields: [driverId], references: [id])
  recoveryWalletTxn DriverCommissionWalletTransaction? @relation(fields: [recoveryWalletTxnId], references: [id])

  @@unique([rideId, kind])
  @@index([driverId, status])
  @@map("commission_collection_failures")
}

/// Company-configurable predefined recharge amounts ("boxes"). Deactivating one
/// never rewrites a past transaction that used it — history references the
/// amount directly, not this row.
model WalletRechargeOption {
  id        String   @id @default(uuid(7)) @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  label     String?
  status    String   @default("ACTIVE") // 'ACTIVE' | 'INACTIVE'
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, sortOrder])
  @@map("wallet_recharge_options")
}
