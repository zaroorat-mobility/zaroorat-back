// ============================ RIDE ============================

model RideRequest {
  id                   String                                @id @default(uuid(7)) @db.Uuid
  /// "One active request per customer" backstop lives as a raw-SQL partial
  /// unique index (`ride_requests_active_customer_key`, migration
  /// 20260821130000) — same reasoning as the two on `Ride`, above.
  customerId           String                                @map("customer_id") @db.Uuid
  vehicleTypeId        String                                @map("vehicle_type_id") @db.Uuid
  pickupLat            Decimal                               @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng            Decimal                               @map("pickup_lng") @db.Decimal(10, 7)
  pickupLocation       Unsupported("geography(Point,4326)")  @map("pickup_location")
  pickupAddress        String?                               @map("pickup_address")
  dropLat              Decimal?                              @map("drop_lat") @db.Decimal(10, 7)
  dropLng              Decimal?                              @map("drop_lng") @db.Decimal(10, 7)
  dropLocation         Unsupported("geography(Point,4326)")? @map("drop_location")
  dropAddress          String?                               @map("drop_address")
  estimatedDistanceKm  Decimal?                              @map("estimated_distance_km") @db.Decimal(8, 2)
  estimatedDurationMin Int?                                  @map("estimated_duration_min")
  quotedFare           Decimal?                              @map("quoted_fare") @db.Decimal(10, 2)
  surgeMultiplier      Decimal                               @default(1.0) @map("surge_multiplier") @db.Decimal(4, 2)
  paymentMethod        String?                               @map("payment_method")
  promoCode            String?                               @map("promo_code")
  scheduledFor         DateTime?                             @map("scheduled_for")
  status               RideRequestStatus                     @default(CREATED)
  rideId               String?                               @map("ride_id") @db.Uuid
  createdAt            DateTime                              @default(now()) @map("created_at")
  expiresAt            DateTime?                             @map("expires_at")

  vehicleType    VehicleType     @relation(fields: [vehicleTypeId], references: [id])
  dispatches     RideDispatch[]
  rides          Ride[]
  scheduledRides ScheduledRide[]

  @@index([customerId])
  @@index([status])
  @@map("ride_requests")
}

model RideDispatch {
  id               String           @id @default(uuid(7)) @db.Uuid
  requestId        String           @map("request_id") @db.Uuid
  driverId         String           @map("driver_id") @db.Uuid
  vehicleId        String?          @map("vehicle_id") @db.Uuid
  offeredAt        DateTime         @default(now()) @map("offered_at")
  respondedAt      DateTime?        @map("responded_at")
  response         DispatchResponse @default(PENDING)
  rejectReason     String?          @map("reject_reason")
  driverDistanceM  Int?             @map("driver_distance_m")
  driverEtaSeconds Int?             @map("driver_eta_seconds")
  dispatchRound    Int              @default(1) @map("dispatch_round") @db.SmallInt
  expiresAt        DateTime?        @map("expires_at")

  request RideRequest @relation(fields: [requestId], references: [id])
  driver  Driver      @relation(fields: [driverId], references: [id])
  vehicle Vehicle?    @relation(fields: [vehicleId], references: [id])

  @@unique([requestId, driverId])
  @@index([driverId])
  @@index([response])
  @@map("ride_dispatches")
}

model Ride {
  id                String                                @id @default(uuid(7)) @db.Uuid
  rideCode          String                                @unique @map("ride_code")
  /// One ride per request. The application selects a winner with a row lock
  /// plus a conditional claim on the request; this is the database backstop
  /// that makes a double-accept fail loudly rather than double-book a customer.
  requestId         String                                @unique @map("request_id") @db.Uuid
  /// "One active ride per customer" backstop lives as a raw-SQL partial unique
  /// index (`rides_active_customer_key`, migration 20260821130000) — Prisma
  /// can't express a WHERE-scoped unique constraint, so it isn't declared here.
  customerId        String                                @map("customer_id") @db.Uuid
  /// Same backstop, same migration: `rides_active_driver_key`.
  driverId          String                                @map("driver_id") @db.Uuid
  vehicleId         String                                @map("vehicle_id") @db.Uuid
  vehicleTypeId     String                                @map("vehicle_type_id") @db.Uuid
  status            RideStatus                            @default(ACCEPTED)
  paymentMethod     PaymentMethod                         @map("payment_method")
  paymentStatus     PaymentStatus                         @default(PENDING) @map("payment_status")
  pickupLocation    Unsupported("geography(Point,4326)")  @map("pickup_location")
  pickupAddress     String?                               @map("pickup_address")
  dropLocation      Unsupported("geography(Point,4326)")? @map("drop_location")
  dropAddress       String?                               @map("drop_address")
  acceptedAt        DateTime                              @default(now()) @map("accepted_at")
  arrivedAt         DateTime?                             @map("arrived_at")
  startedAt         DateTime?                             @map("started_at")
  completedAt       DateTime?                             @map("completed_at")
  cancelledAt       DateTime?                             @map("cancelled_at")
  actualDistanceKm  Decimal?                              @map("actual_distance_km") @db.Decimal(8, 2)
  actualDurationMin Int?                                  @map("actual_duration_min")
  waitTimeMin       Int                                   @default(0) @map("wait_time_min")
  isScheduled       Boolean                               @default(false) @map("is_scheduled")
  createdAt         DateTime                              @default(now()) @map("created_at")
  updatedAt         DateTime                              @updatedAt @map("updated_at")

  request     RideRequest @relation(fields: [requestId], references: [id])
  customer    User        @relation("CustomerRides", fields: [customerId], references: [id])
  driver      Driver      @relation(fields: [driverId], references: [id])
  vehicle     Vehicle     @relation(fields: [vehicleId], references: [id])
  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id])

  stops               RideStop[]
  statusEvents        RideStatusEvent[]
  fare                RideFare?
  fareLines           RideFareLine[]
  cancellation        RideCancellation?
  otps                RideOtp[]
  receipt             RideReceipt?
  payments            RidePayment[]
  ratings             RideRating[]
  promosApplied       RidePromoApplied[]
  routePlan           RideRoutePlan?
  waitEvents          RideWaitEvent[]
  disputes            RideDispute[]
  promoRedemptions    PromotionRedemption[]
  paymentIntents      PaymentIntent[]
  paymentTransactions PaymentTransaction[]
  refunds             Refund[]
  chargebacks         Chargeback[]
  payoutItems         PayoutItem[]
  cashbackGrants      CashbackGrant[]
  chatConversations   ChatConversation[]
  supportTickets      SupportTicket[]
  redeemedCoupons     Coupon[]

  @@index([customerId])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
  @@map("rides")
}

model RideStop {
  id         String                               @id @default(uuid(7)) @db.Uuid
  rideId     String                               @map("ride_id") @db.Uuid
  sequence   Int                                  @db.SmallInt
  stopType   String                               @map("stop_type")
  location   Unsupported("geography(Point,4326)")
  address    String?
  arrivedAt  DateTime?                            @map("arrived_at")
  departedAt DateTime?                            @map("departed_at")

  ride Ride @relation(fields: [rideId], references: [id])

  @@unique([rideId, sequence])
  @@map("ride_stops")
}

model RideStatusEvent {
  id         String                                @id @default(uuid(7)) @db.Uuid
  rideId     String                                @map("ride_id") @db.Uuid
  fromStatus String?                               @map("from_status")
  toStatus   String                                @map("to_status")
  actorType  String?                               @map("actor_type")
  actorId    String?                               @map("actor_id") @db.Uuid
  reason     String?
  location   Unsupported("geography(Point,4326)")?
  createdAt  DateTime                              @default(now()) @map("created_at")

  ride Ride @relation(fields: [rideId], references: [id])

  @@index([rideId, createdAt])
  @@map("ride_status_events")
}

// NOTE: ride_track_points is RANGE-partitioned — manage via raw SQL, not Prisma.

model RideFare {
  id                 String   @id @default(uuid(7)) @db.Uuid
  rideId             String   @unique @map("ride_id") @db.Uuid
  currency           String   @default("INR") @db.Char(3)
  baseFare           Decimal  @map("base_fare") @db.Decimal(10, 2)
  distanceFare       Decimal  @map("distance_fare") @db.Decimal(10, 2)
  timeFare           Decimal  @map("time_fare") @db.Decimal(10, 2)
  waitingCharge      Decimal  @default(0) @map("waiting_charge") @db.Decimal(10, 2)
  surgeMultiplier    Decimal  @default(1.0) @map("surge_multiplier") @db.Decimal(4, 2)
  surgeAmount        Decimal  @default(0) @map("surge_amount") @db.Decimal(10, 2)
  subtotal           Decimal  @db.Decimal(10, 2)
  discountAmount     Decimal  @default(0) @map("discount_amount") @db.Decimal(10, 2)
  taxAmount          Decimal  @default(0) @map("tax_amount") @db.Decimal(10, 2)
  tollAmount         Decimal  @default(0) @map("toll_amount") @db.Decimal(10, 2)
  platformFee        Decimal  @default(0) @map("platform_fee") @db.Decimal(10, 2)
  tipAmount          Decimal  @default(0) @map("tip_amount") @db.Decimal(10, 2)
  totalFare          Decimal  @map("total_fare") @db.Decimal(10, 2)
  driverEarning      Decimal  @map("driver_earning") @db.Decimal(10, 2)
  platformCommission Decimal  @map("platform_commission") @db.Decimal(10, 2)
  createdAt          DateTime @default(now()) @map("created_at")

  ride Ride @relation(fields: [rideId], references: [id])

  @@map("ride_fares")
}

model RideFareLine {
  id       String  @id @default(uuid(7)) @db.Uuid
  rideId   String  @map("ride_id") @db.Uuid
  lineType String  @map("line_type")
  label    String?
  amount   Decimal @db.Decimal(10, 2)
  sequence Int?    @db.SmallInt

  ride Ride @relation(fields: [rideId], references: [id])

  @@index([rideId])
  @@map("ride_fare_lines")
}

model RideCancellation {
  id                String   @id @default(uuid(7)) @db.Uuid
  rideId            String   @unique @map("ride_id") @db.Uuid
  cancelledBy       String   @map("cancelled_by")
  actorId           String?  @map("actor_id") @db.Uuid
  reasonCode        String   @map("reason_code")
  reasonText        String?  @map("reason_text")
  cancelledAtStatus String?  @map("cancelled_at_status")
  cancellationFee   Decimal  @default(0) @map("cancellation_fee") @db.Decimal(10, 2)
  feeCharged        Boolean  @default(false) @map("fee_charged")
  createdAt         DateTime @default(now()) @map("created_at")

  ride Ride @relation(fields: [rideId], references: [id])

  @@map("ride_cancellations")
}

model RideOtp {
  id         String    @id @default(uuid(7)) @db.Uuid
  rideId     String    @map("ride_id") @db.Uuid
  otpHash    String    @map("otp_hash")
  purpose    String    @default("START")
  attempts   Int       @default(0) @db.SmallInt
  verified   Boolean   @default(false)
  verifiedAt DateTime? @map("verified_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  ride Ride @relation(fields: [rideId], references: [id])

  @@index([rideId])
  @@map("ride_otps")
}

model RideReceipt {
  id            String   @id @default(uuid(7)) @db.Uuid
  rideId        String   @unique @map("ride_id") @db.Uuid
  receiptNumber String   @unique @map("receipt_number")
  snapshotJson  Json     @map("snapshot_json")
  pdfUrl        String?  @map("pdf_url")
  issuedAt      DateTime @default(now()) @map("issued_at")

  ride Ride @relation(fields: [rideId], references: [id])

  @@map("ride_receipts")
}

model RidePayment {
  id        String    @id @default(uuid(7)) @db.Uuid
  rideId    String    @map("ride_id") @db.Uuid
  paymentId String?   @map("payment_id") @db.Uuid
  amount    Decimal   @db.Decimal(10, 2)
  method    String
  status    String    @default("PENDING")
  settledAt DateTime? @map("settled_at")
  createdAt DateTime  @default(now()) @map("created_at")

  ride Ride @relation(fields: [rideId], references: [id])

  @@index([rideId])
  @@map("ride_payments")
}

model RideRating {
  id        String   @id @default(uuid(7)) @db.Uuid
  rideId    String   @map("ride_id") @db.Uuid
  ratedBy   String   @map("rated_by")
  rating    Int      @db.SmallInt
  tags      String[]
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  ride           Ride                  @relation(fields: [rideId], references: [id])
  tagAssignments ReviewTagAssignment[]
  flags          ReviewFlag[]
  response       ReviewResponse?

  @@unique([rideId, ratedBy])
  @@map("ride_ratings")
}

model RidePromoApplied {
  id             String   @id @default(uuid(7)) @db.Uuid
  rideId         String   @map("ride_id") @db.Uuid
  promoCode      String   @map("promo_code")
  promoId        String?  @map("promo_id") @db.Uuid
  discountAmount Decimal  @map("discount_amount") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  ride Ride @relation(fields: [rideId], references: [id])

  @@index([rideId])
  @@map("ride_promos_applied")
}

model ScheduledRide {
  id             String    @id @default(uuid(7)) @db.Uuid
  requestId      String    @map("request_id") @db.Uuid
  customerId     String    @map("customer_id") @db.Uuid
  scheduledFor   DateTime  @map("scheduled_for")
  status         String    @default("SCHEDULED")
  reminderSentAt DateTime? @map("reminder_sent_at")
  rideId         String?   @map("ride_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  request RideRequest @relation(fields: [requestId], references: [id])

  @@index([scheduledFor])
  @@map("scheduled_rides")
}

model RideRoutePlan {
  id                 String   @id @default(uuid(7)) @db.Uuid
  rideId             String   @unique @map("ride_id") @db.Uuid
  encodedPolyline    String?  @map("encoded_polyline")
  plannedDistanceKm  Decimal? @map("planned_distance_km") @db.Decimal(8, 2)
  plannedDurationMin Int?     @map("planned_duration_min")
  createdAt          DateTime @default(now()) @map("created_at")

  ride Ride @relation(fields: [rideId], references: [id])

  @@map("ride_route_plan")
}

model RideWaitEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  rideId        String    @map("ride_id") @db.Uuid
  startedAt     DateTime  @map("started_at")
  endedAt       DateTime? @map("ended_at")
  billedMinutes Int       @default(0) @map("billed_minutes")
  charge        Decimal   @default(0) @db.Decimal(10, 2)

  ride Ride @relation(fields: [rideId], references: [id])

  @@index([rideId])
  @@map("ride_wait_events")
}

model RideDispute {
  id           String    @id @default(uuid(7)) @db.Uuid
  rideId       String    @map("ride_id") @db.Uuid
  raisedBy     String    @map("raised_by")
  category     String
  description  String?
  status       String    @default("OPEN")
  resolution   String?
  refundAmount Decimal   @default(0) @map("refund_amount") @db.Decimal(10, 2)
  createdAt    DateTime  @default(now()) @map("created_at")
  resolvedAt   DateTime? @map("resolved_at")

  ride Ride @relation(fields: [rideId], references: [id])

  @@index([rideId])
  @@index([status])
  @@map("ride_disputes")
}
