model VehicleType {
  id                String @id @default(uuid(7)) @db.Uuid
  code              String @unique
  name              String
  passengerCapacity Int?   @map("passenger_capacity") @db.SmallInt
  luggageCapacity   Int?   @map("luggage_capacity") @db.SmallInt

  icon         String?
  displayOrder Int      @default(0) @map("display_order") @db.SmallInt
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  vehicles     Vehicle[]
  rideRequests RideRequest[]
  rides        Ride[]
  pricingRules PricingRule[]
  surgeWindows SurgeWindow[]
  promotions   Promotion[]

  @@index([isActive, displayOrder])
  @@map("vehicle_types")
}

model Vehicle {
  id                 String  @id @default(uuid(7)) @db.Uuid
  registrationNumber String  @unique @map("registration_number")
  registrationState  String? @map("registration_state")
  vin                String? @unique
  make               String?
  model              String?
  manufacturingYear  Int?    @map("manufacturing_year") @db.SmallInt
  color              String?
  fuelType           String? @map("fuel_type")
  seatingCapacity    Int?    @map("seating_capacity") @db.SmallInt
  vehicleTypeId      String  @map("vehicle_type_id") @db.Uuid
  ownerName          String? @map("owner_name")
  ownerPhone         String? @map("owner_phone")
  currentOdometer    Int?    @map("current_odometer")
  currentDriverId    String? @map("current_driver_id") @db.Uuid

  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedBy         String?            @map("verified_by") @db.Uuid
  verifiedAt         DateTime?          @map("verified_at")
  rejectionReason    String?            @map("rejection_reason")
  isActive           Boolean            @default(true) @map("is_active")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  vehicleType     VehicleType         @relation(fields: [vehicleTypeId], references: [id])
  documents       VehicleDocument[]
  images          VehicleImage[]
  inspections     VehicleInspection[]
  maintenanceLogs MaintenanceLog[]
  fuelLogs        FuelLog[]
  insuranceClaims InsuranceClaim[]
  assignments     VehicleAssignment[]
  dispatches      RideDispatch[]
  rides           Ride[]

  @@index([vehicleTypeId])
  @@index([isActive])
  @@index([verificationStatus])
  @@map("vehicles")
}

model VehicleAssignment {
  id String @id @default(uuid(7)) @db.Uuid

  driverId   String    @map("driver_id") @db.Uuid
  vehicleId  String    @map("vehicle_id") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at")
  releasedAt DateTime? @map("released_at")
  reason     String?
  assignedBy String?   @map("assigned_by") @db.Uuid
  status     String    @default("ACTIVE")
  createdAt  DateTime  @default(now()) @map("created_at")

  driver  Driver  @relation(fields: [driverId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([driverId])
  @@index([vehicleId])
  @@map("vehicle_assignments")
}

model VehicleDocument {
  id             String  @id @default(uuid(7)) @db.Uuid
  vehicleId      String  @map("vehicle_id") @db.Uuid
  documentType   String  @map("document_type")
  documentNumber String? @map("document_number")

  fileUrl            String?            @map("file_url")
  fileId             String?            @map("file_id") @db.Uuid
  issuedAt           DateTime?          @map("issued_at") @db.Date
  expiresAt          DateTime?          @map("expires_at") @db.Date
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedBy         String?            @map("verified_by") @db.Uuid
  verifiedAt         DateTime?          @map("verified_at")
  rejectionReason    String?            @map("rejection_reason")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  file    File?   @relation(fields: [fileId], references: [id])

  @@unique([vehicleId, documentType], map: "vehicle_documents_vehicle_id_document_type_key")
  @@index([vehicleId])
  @@index([expiresAt])
  @@map("vehicle_documents")
}

model VehicleImage {
  id         String   @id @default(uuid(7)) @db.Uuid
  vehicleId  String   @map("vehicle_id") @db.Uuid
  imageType  String   @map("image_type")
  imageUrl   String   @map("image_url")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@map("vehicle_images")
}

model VehicleInspection {
  id          String   @id @default(uuid(7)) @db.Uuid
  vehicleId   String   @map("vehicle_id") @db.Uuid
  inspectedBy String?  @map("inspected_by") @db.Uuid
  inspectedAt DateTime @default(now()) @map("inspected_at")
  checklist   Json?
  result      String // PASSED | FAILED | REPAIR_REQUIRED
  notes       String?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@map("vehicle_inspections")
}

model MaintenanceLog {
  id          String    @id @default(uuid(7)) @db.Uuid
  vehicleId   String    @map("vehicle_id") @db.Uuid
  serviceDate DateTime  @map("service_date") @db.Date
  workshop    String?
  description String?
  cost        Decimal?  @db.Decimal(10, 2)
  odometer    Int?
  nextDueDate DateTime? @map("next_due_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@map("maintenance_logs")
}

model FuelLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  vehicleId   String   @map("vehicle_id") @db.Uuid
  fuelAmount  Decimal? @map("fuel_amount") @db.Decimal(8, 2)
  fuelCost    Decimal? @map("fuel_cost") @db.Decimal(10, 2)
  fuelStation String?  @map("fuel_station")
  odometer    Int?
  loggedAt    DateTime @map("logged_at") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@map("fuel_logs")
}

model InsuranceClaim {
  id               String    @id @default(uuid(7)) @db.Uuid
  vehicleId        String    @map("vehicle_id") @db.Uuid
  claimNumber      String?   @map("claim_number")
  insuranceCompany String?   @map("insurance_company")
  status           String?
  amount           Decimal?  @db.Decimal(12, 2)
  accidentDate     DateTime? @map("accident_date") @db.Date
  settlementDate   DateTime? @map("settlement_date") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@map("insurance_claims")
}

model AccidentReport {
  id           String                                @id @default(uuid(7)) @db.Uuid
  vehicleId    String                                @map("vehicle_id") @db.Uuid
  driverId     String?                               @map("driver_id") @db.Uuid
  rideId       String?                               @map("ride_id") @db.Uuid
  policeReport String?                               @map("police_report")
  description  String?
  location     Unsupported("geography(Point,4326)")?
  images       Json?
  witnesses    Json?
  occurredAt   DateTime?                             @map("occurred_at")
  createdAt    DateTime                              @default(now()) @map("created_at")

  @@index([vehicleId])
  @@index([driverId])
  @@map("accident_reports")
}
