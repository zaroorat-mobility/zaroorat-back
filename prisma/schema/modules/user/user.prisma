// ============================ IDENTITY ============================

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  phoneNumber     String     @map("phone_number") // E.164 (+91…); active-uniqueness is PARTIAL (doc 03 §4)
  email           String?    @unique // reserved (OD-7), nullable
  passwordHash    String?    @map("password_hash") // reserved (OD-7), nullable
  status          UserStatus @default(UNVERIFIED)
  isPhoneVerified Boolean    @default(false) @map("is_phone_verified")
  isEmailVerified Boolean    @default(false) @map("is_email_verified")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  profile                       UserProfile?
  devices                       UserDevice[]
  sessions                      UserSession[]
  refreshTokens                 RefreshToken[]
  otpVerifications              OtpVerification[]
  emergencyContacts             EmergencyContact[]
  savedPlaces                   SavedPlace[]
  files                         File[]
  driver                        Driver?
  customerRides                 Ride[]                         @relation("CustomerRides")
  promoRedemptions              PromotionRedemption[]
  paymentMethods                PaymentInstrument[]
  customerWallet                CustomerWallet?
  paymentIntents                PaymentIntent[]
  paymentTransactions           PaymentTransaction[]
  refunds                       Refund[]
  walletTopups                  WalletTopup[]
  cashbackGrants                CashbackGrant[]
  notifications                 Notification[]
  notificationPreferences       NotificationPreference[]
  inAppMessages                 InAppMessage[]
  campaignRecipients            CampaignRecipient[]
  chatParticipants              ChatParticipant[]
  chatMessages                  ChatMessage[]
  chatReadReceipts              ChatReadReceipt[]
  chatBlocksMade                ChatBlock[]                    @relation("Blocker")
  chatBlocksReceived            ChatBlock[]                    @relation("Blocked")
  chatReportsMade               ChatReport[]                   @relation("Reporter")
  chatReportsReceived           ChatReport[]                   @relation("Reported")
  customerRatingAggregate       CustomerRatingAggregate?
  reviewFlagsRaised             ReviewFlag[]                   @relation("FlaggedBy")
  reviewFlagsModerated          ReviewFlag[]                   @relation("Moderator")
  reviewResponses               ReviewResponse[]
  supportTickets                SupportTicket[]
  supportAgent                  SupportAgent?
  ticketMessages                SupportTicketMessage[]
  referralCodes                 ReferralCode[]
  referralsMade                 Referral[]                     @relation("Referrer")
  referralsReceived             Referral[]                     @relation("Referee")
  referralRewards               ReferralReward[]
  referralMilestoneAchievements ReferralMilestoneAchievement[]
  referralFraudReviews          ReferralFraudFlag[]
  assignedCoupons               Coupon[]
  roleAssignments               UserRoleAssignment[]
  adminActivityLogs             AdminActivityLog[]
  featureFlagOverrides          FeatureFlagOverride[]
  adminSessions                 AdminSession[]
  deletionRequests              AccountDeletionRequest[]

  @@index([status])
  @@map("users")
}

/// The deletion-request ledger (user doc 02 §2.8, R-USER-18/19).
///
/// `POST /me/delete-request` recorded only an outbox event before this table
/// existed, and an outbox row is a dispatch queue, not a ledger: it has no
/// "erased yet?" state, nothing to index "due for erasure" on, and it is
/// append-only by platform policy. Without somewhere to record the promise, the
/// endpoint accepted an obligation nothing could discharge.
model AccountDeletionRequest {
  id           String                @id @default(uuid(7)) @db.Uuid
  userId       String                @map("user_id") @db.Uuid
  status       DeletionRequestStatus @default(PENDING)
  /// When the user asked.
  requestedAt  DateTime              @default(now()) @map("requested_at")
  /// The earliest the erasure job may act — request + the retention window.
  /// Stored rather than recomputed, so shortening the window in config can never
  /// bring forward an erasure the user was already told the date of.
  scheduledFor DateTime              @map("scheduled_for")
  erasedAt     DateTime?             @map("erased_at")
  /// Set when an operator restores the account before the window closes.
  cancelledAt  DateTime?             @map("cancelled_at")

  user User @relation(fields: [userId], references: [id])

  // The job's only query: PENDING rows whose date has passed (doc 03 §5).
  @@index([status, scheduledFor], map: "ix_deletion_requests_due")
  // At most one PENDING row per user is a PARTIAL unique index, in the same
  // migration — Prisma cannot express the predicate (doc 03 §4).
  @@map("account_deletion_requests")
}

/// Terminal states are one-way. A cancelled request is not reopened — the user
/// asks again, and gets a new window from the day they ask.
enum DeletionRequestStatus {
  PENDING
  ERASED
  CANCELLED
}

model UserProfile {
  id                 String    @id @default(uuid(7)) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  firstName          String?   @map("first_name")
  lastName           String?   @map("last_name")
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  gender             String?
  /// The avatar, as a file reference (FILES-OD-2). A domain row never holds a
  /// URL: a URL is minted per read, for one reader, and expires. `@unique` is
  /// R-FILE-33 — at most one live domain row may reference a file.
  profileImageFileId String?   @unique @map("profile_image_file_id") @db.Uuid
  languageCode       String?   @default("en") @map("language_code")
  referralCode       String?   @unique @map("referral_code")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user             User  @relation(fields: [userId], references: [id])
  // `Restrict`, not Prisma's `SetNull` default for an optional relation: a file
  // row backing a live avatar must not be removable, and a silent NULL would
  // turn a foreign-key violation into a user losing their photograph with
  // nothing in the logs.
  profileImageFile File? @relation("ProfileImage", fields: [profileImageFileId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("user_profiles")
}

model UserDevice {
  id           String           @id @default(uuid(7)) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  deviceId     String?          @map("device_id") // client-reported stable id
  platform     AppPlatform?
  trustState   DeviceTrustState @default(REGISTERED) @map("trust_state")
  fingerprint  String?          @map("device_fingerprint")
  isRooted     Boolean          @default(false) @map("is_rooted")
  isJailbroken Boolean          @default(false) @map("is_jailbroken")
  fcmToken     String?          @map("fcm_token")
  appVersion   String?          @map("app_version")
  osVersion    String?          @map("os_version")
  lastSeenAt   DateTime?        @map("last_seen_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  user       User                   @relation(fields: [userId], references: [id])
  sessions   UserSession[]
  deliveries NotificationDelivery[]

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("user_devices")
}

model EmergencyContact {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  contactName  String   @map("contact_name")
  phoneNumber  String   @map("phone_number")
  relationship String?
  priority     Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  // Ownership scoping — every query in doc 02 §2.5 filters on user_id (doc 03 §5.1).
  @@index([userId], map: "ix_emergency_contacts_user")
  // Notification order — `sos` reads by (user, priority), R-USER-23 (doc 03 §5.4).
  @@index([userId, priority], map: "ix_emergency_contacts_priority")
  @@map("emergency_contacts")
}

model SavedPlace {
  id           String                                @id @default(uuid(7)) @db.Uuid
  userId       String                                @map("user_id") @db.Uuid
  label        String
  address      String?
  buildingName String?                               @map("building_name")
  landmark     String?
  floor        String?
  instructions String?
  latitude     Decimal?                              @db.Decimal(10, 7)
  longitude    Decimal?                              @db.Decimal(10, 7)
  location     Unsupported("geography(Point,4326)")?
  createdAt    DateTime                              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  // Ownership scoping (doc 03 §5.1). The per-user case-insensitive label unique
  // and the GiST index on `location` live in raw SQL in the same migration —
  // Prisma can express neither a functional index nor an index on `Unsupported`.
  @@index([userId], map: "ix_saved_places_user")
  @@map("saved_places")
}
