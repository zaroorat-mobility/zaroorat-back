// ============================ ANALYTICS ============================
// Note: analytics_events is RANGE-partitioned — managed via raw SQL, not Prisma.

model EventType {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  name        String
  category    String?
  description String?
  schema      Json?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("event_types")
}

model DailyMetric {
  id          String            @id @default(uuid(7)) @db.Uuid
  metricDate  DateTime          @map("metric_date") @db.Date
  metricKey   String            @map("metric_key")
  cityCode    String?           @map("city_code")
  granularity MetricGranularity @default(DAILY)
  value       Decimal           @default(0) @db.Decimal(18, 4)
  count       BigInt            @default(0)
  createdAt   DateTime          @default(now()) @map("created_at")

  @@unique([metricDate, metricKey, cityCode])
  @@index([metricKey, metricDate])
  @@map("daily_metrics")
}

model Funnel {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  steps       FunnelStep[]
  @@map("funnels")
}

model FunnelStep {
  id            String   @id @default(uuid(7)) @db.Uuid
  funnelId      String   @map("funnel_id") @db.Uuid
  stepOrder     Int      @map("step_order") @db.SmallInt
  name          String
  eventTypeCode String   @map("event_type_code")
  createdAt     DateTime @default(now()) @map("created_at")

  funnel        Funnel   @relation(fields: [funnelId], references: [id])
  @@unique([funnelId, stepOrder])
  @@map("funnel_steps")
}

model Cohort {
  id         String   @id @default(uuid(7)) @db.Uuid
  code       String   @unique
  name       String
  definition Json?
  cohortDate DateTime @map("cohort_date") @db.Date
  size       Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  retention  CohortRetention[]
  @@map("cohorts")
}

model CohortRetention {
  id            String   @id @default(uuid(7)) @db.Uuid
  cohortId      String   @map("cohort_id") @db.Uuid
  periodNumber  Int      @map("period_number") @db.SmallInt
  retainedCount Int      @default(0) @map("retained_count")
  retentionRate Decimal  @default(0) @map("retention_rate") @db.Decimal(5, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  cohort        Cohort   @relation(fields: [cohortId], references: [id])
  @@unique([cohortId, periodNumber])
  @@map("cohort_retention")
}

model KpiSnapshot {
  id          String            @id @default(uuid(7)) @db.Uuid
  snapshotAt  DateTime          @map("snapshot_at")
  granularity MetricGranularity @default(DAILY)
  cityCode    String?           @map("city_code")
  kpis        Json
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([snapshotAt])
  @@map("kpi_snapshots")
}

model DashboardWidget {
  id           String   @id @default(uuid(7)) @db.Uuid
  dashboardKey String   @map("dashboard_key")
  title        String
  widgetType   String   @map("widget_type")
  query        Json
  position     Int?     @default(0) @db.SmallInt
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([dashboardKey])
  @@map("dashboard_widgets")
}

model ReportExport {
  id          String       @id @default(uuid(7)) @db.Uuid
  reportType  String       @map("report_type")
  params      Json?
  format      ReportFormat @default(CSV)
  status      ReportStatus @default(PENDING)
  fileUrl     String?      @map("file_url")
  rowCount    Int?         @map("row_count")
  requestedBy String?      @map("requested_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  completedAt DateTime?    @map("completed_at")

  @@index([status])
  @@map("report_exports")
}


