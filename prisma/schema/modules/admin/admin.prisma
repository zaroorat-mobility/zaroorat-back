// ============================ ADMIN ============================

// RBAC source of truth for identity roles (auth doc 03, OD-2). `slug` holds the
// canonical role identifier: 'customer' | 'driver' | 'admin' | 'support'.
model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String           @id @default(uuid(7)) @db.Uuid
  roleId       String           @map("role_id") @db.Uuid
  permissionId String           @map("permission_id") @db.Uuid
  effect       PermissionEffect @default(ALLOW)

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  grantedBy String?   @map("granted_by") @db.Uuid // actor (R-ACCOUNT-7); null = system grant
  grantedAt DateTime  @default(now()) @map("granted_at")
  revokedAt DateTime? @map("revoked_at") // revocation is a timestamp, not a row delete
  expiresAt DateTime? @map("expires_at") // scoped / temporary roles

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])
  // Active-uniqueness (one live assignment per user+role, re-grant allowed after
  // revoke) is a PARTIAL unique index shipped as raw SQL — see doc 03 §4.

  @@index([userId])
  @@map("user_roles")
}

model AdminActivityLog {
  id         String      @id @default(uuid(7)) @db.Uuid
  actorId    String?     @map("actor_id") @db.Uuid
  action     AuditAction
  entityType String?     @map("entity_type")
  entityId   String?     @map("entity_id") @db.Uuid
  summary    String?
  ipAddress  String?     @map("ip_address") @db.Inet
  userAgent  String?     @map("user_agent")
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at")

  actor        User?              @relation(fields: [actorId], references: [id])
  fieldChanges AuditFieldChange[]

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("admin_activity_logs")
}

model AuditFieldChange {
  id            String  @id @default(uuid(7)) @db.Uuid
  activityLogId String  @map("activity_log_id") @db.Uuid
  fieldName     String  @map("field_name")
  oldValue      String? @map("old_value")
  newValue      String? @map("new_value")

  activityLog AdminActivityLog @relation(fields: [activityLogId], references: [id])

  @@index([activityLogId])
  @@map("audit_field_changes")
}

model SystemSetting {
  id          String      @id @default(uuid(7)) @db.Uuid
  key         String      @unique
  value       String?
  valueType   SettingType @default(STRING) @map("value_type")
  category    String?
  description String?
  isSecret    Boolean     @default(false) @map("is_secret")
  version     Int         @default(1)
  updatedBy   String?     @map("updated_by") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([category])
  @@map("system_settings")
}

model FeatureFlag {
  id                String            @id @default(uuid(7)) @db.Uuid
  key               String            @unique
  name              String?
  description       String?
  status            FeatureFlagStatus @default(OFF)
  rolloutPercentage Int               @default(0) @map("rollout_percentage") @db.SmallInt
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  overrides FeatureFlagOverride[]

  @@map("feature_flags")
}

model FeatureFlagOverride {
  id          String   @id @default(uuid(7)) @db.Uuid
  flagId      String   @map("flag_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  segmentCode String?  @map("segment_code")
  enabled     Boolean
  createdAt   DateTime @default(now()) @map("created_at")

  flag FeatureFlag @relation(fields: [flagId], references: [id])
  user User?       @relation(fields: [userId], references: [id])

  @@index([flagId])
  @@index([userId])
  @@map("feature_flag_overrides")
}

model AdminSession {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  ipAddress   String?   @map("ip_address") @db.Inet
  userAgent   String?   @map("user_agent")
  mfaVerified Boolean   @default(false) @map("mfa_verified")
  startedAt   DateTime  @default(now()) @map("started_at")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("admin_sessions")
}

model ApiKey {
  id         String       @id @default(uuid(7)) @db.Uuid
  name       String
  keyHash    String       @map("key_hash")
  prefix     String?
  scopes     Json?
  status     ApiKeyStatus @default(ACTIVE)
  createdBy  String?      @map("created_by") @db.Uuid
  lastUsedAt DateTime?    @map("last_used_at")
  expiresAt  DateTime?    @map("expires_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([prefix])
  @@map("api_keys")
}

model IpAllowlistEntry {
  id        String   @id @default(uuid(7)) @db.Uuid
  cidr      String   @db.Inet
  label     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ip_allowlist")
}

// ============================ SYSTEM ============================
// Note: geography columns are Unsupported(...); managed for indexing via raw SQL.

model City {
  id         String                                  @id @default(uuid(7)) @db.Uuid
  code       String                                  @unique
  name       String
  state      String?
  country    String                                  @default("India")
  timezone   String                                  @default("Asia/Kolkata")
  currency   String                                  @default("INR") @db.Char(3)
  center     Unsupported("geography(Point,4326)")?
  boundary   Unsupported("geography(Polygon,4326)")?
  isActive   Boolean                                 @default(true) @map("is_active")
  launchedAt DateTime?                               @map("launched_at") @db.Date
  createdAt  DateTime                                @default(now()) @map("created_at")

  zones ServiceZone[]

  @@map("cities")
}

model ServiceZone {
  id        String                                 @id @default(uuid(7)) @db.Uuid
  cityId    String                                 @map("city_id") @db.Uuid
  code      String
  name      String
  zoneType  String                                 @default("SERVICE") @map("zone_type")
  boundary  Unsupported("geography(Polygon,4326)")
  isActive  Boolean                                @default(true) @map("is_active")
  createdAt DateTime                               @default(now()) @map("created_at")

  city City @relation(fields: [cityId], references: [id])

  @@index([cityId])
  @@map("service_zones")
}

model AppVersion {
  id          String      @id @default(uuid(7)) @db.Uuid
  platform    AppPlatform
  version     String
  buildNumber Int?        @map("build_number")
  isSupported Boolean     @default(true) @map("is_supported")
  forceUpdate Boolean     @default(false) @map("force_update")
  changelog   String?
  releasedAt  DateTime?   @map("released_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@unique([platform, version])
  @@map("app_versions")
}

model JobQueue {
  id          String    @id @default(uuid(7)) @db.Uuid
  jobType     String    @map("job_type")
  payload     Json?
  status      JobStatus @default(QUEUED)
  priority    Int       @default(0) @db.SmallInt
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  runAt       DateTime  @default(now()) @map("run_at")
  lockedAt    DateTime? @map("locked_at")
  lockedBy    String?   @map("locked_by")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@map("job_queue")
}

model ScheduledJob {
  id             String    @id @default(uuid(7)) @db.Uuid
  name           String    @unique
  cronExpression String    @map("cron_expression")
  jobType        String    @map("job_type")
  payload        Json?
  isActive       Boolean   @default(true) @map("is_active")
  lastRunAt      DateTime? @map("last_run_at")
  nextRunAt      DateTime? @map("next_run_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("scheduled_jobs")
}

/// The transactional outbox. Rows are written in the same transaction as the
/// state change they record, and the relay claims, dispatches, and retires them.
model OutboxEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  /// The envelope's own id, lifted out of `payload` so the database can reject a
  /// double-enqueue and consumers have a dedupe key that survives a replay.
  eventId       String       @unique @map("event_id") @db.Uuid
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id") @db.Uuid
  eventType     String       @map("event_type")
  payload       Json
  status        OutboxStatus @default(PENDING)
  retries       Int          @default(0)
  /// Truncated failure text from the last attempt — what an operator reads when
  /// a row lands in the dead-letter state.
  lastError     String?      @map("last_error")
  /// Earliest instant this row may be claimed. Backoff pushes it out on failure.
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at")
  /// When the current PROCESSING claim was taken; the reaper's input.
  claimedAt     DateTime?    @map("claimed_at")
  /// Identifies *which* claim is current, so a relay whose claim was reaped
  /// cannot overwrite the result of the relay holding the row now. PROCESSING
  /// alone says a row is claimed but not by whom, and both owners read it the
  /// same way.
  claimToken    String?      @map("claim_token") @db.Uuid
  publishedAt   DateTime?    @map("published_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  /// The relay's claim query: `WHERE status = ... AND next_attempt_at <= now()
  /// ORDER BY created_at, id`. Without it that is a sequential scan plus a sort
  /// over the whole table, once a second, from every replica.
  @@index([status, nextAttemptAt, createdAt, id])
  @@map("outbox_events")
}

model WebhookEndpoint {
  id         String   @id @default(uuid(7)) @db.Uuid
  name       String
  url        String
  secret     String?
  eventTypes String[] @map("event_types")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  deliveries WebhookDelivery[]

  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id           String                @id @default(uuid(7)) @db.Uuid
  endpointId   String                @map("endpoint_id") @db.Uuid
  eventType    String                @map("event_type")
  payload      Json
  status       WebhookDeliveryStatus @default(PENDING)
  attempts     Int                   @default(0)
  responseCode Int?                  @map("response_code")
  responseBody String?               @map("response_body")
  nextRetryAt  DateTime?             @map("next_retry_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  deliveredAt  DateTime?             @map("delivered_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id])

  @@index([endpointId])
  @@map("webhook_deliveries")
}

model IdempotencyKey {
  id          String    @id @default(uuid(7)) @db.Uuid
  key         String
  scope       String
  requestHash String?   @map("request_hash")
  response    Json?
  status      String    @default("IN_PROGRESS")
  lockedAt    DateTime? @map("locked_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model RateLimitRule {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String   @unique
  scope         String
  limitCount    Int      @map("limit_count")
  windowSeconds Int      @map("window_seconds")
  action        String   @default("BLOCK")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("rate_limit_rules")
}

model MaintenanceWindow {
  id               String   @id @default(uuid(7)) @db.Uuid
  title            String
  description      String?
  affectedServices String[] @map("affected_services")
  startsAt         DateTime @map("starts_at")
  endsAt           DateTime @map("ends_at")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("maintenance_windows")
}

model DataRetentionPolicy {
  id            String    @id @default(uuid(7)) @db.Uuid
  tableName     String    @unique @map("table_name")
  retentionDays Int       @map("retention_days")
  strategy      String    @default("DELETE")
  isActive      Boolean   @default(true) @map("is_active")
  lastRunAt     DateTime? @map("last_run_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("data_retention_policies")
}
