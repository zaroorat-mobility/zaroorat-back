// ============================ NOTIFICATION ============================

model NotificationTemplate {
  id            String               @id @default(uuid()) @db.Uuid
  code          String
  channel       NotificationChannel
  locale        String               @default("en")
  category      NotificationCategory @default(TRANSACTIONAL)
  titleTemplate String?              @map("title_template")
  bodyTemplate  String               @map("body_template")
  isActive      Boolean              @default(true) @map("is_active")
  version       Int                  @default(1)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  notifications Notification[]
  campaigns     NotificationCampaign[]
  @@map("notification_templates")
}

model NotificationPreference {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  category  NotificationCategory
  channel   NotificationChannel
  enabled   Boolean              @default(true)
  updatedAt DateTime             @updatedAt @map("updated_at")

  user      User                 @relation(fields: [userId], references: [id])
  @@unique([userId, category, channel])
  @@index([userId])
  @@map("notification_preferences")
}

model Notification {
  id            String               @id @default(uuid()) @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  category      NotificationCategory @default(TRANSACTIONAL)
  priority      NotificationPriority @default(NORMAL)
  eventKey      String?              @map("event_key")
  templateId    String?              @map("template_id") @db.Uuid
  title         String?
  body          String?
  data          Json?
  status        NotificationStatus   @default(PENDING)
  referenceType String?              @map("reference_type")
  referenceId   String?              @map("reference_id") @db.Uuid
  createdAt     DateTime             @default(now()) @map("created_at")
  readAt        DateTime?            @map("read_at")

  user          User                   @relation(fields: [userId], references: [id])
  template      NotificationTemplate?  @relation(fields: [templateId], references: [id])
  deliveries    NotificationDelivery[]
  inAppMessages InAppMessage[]
  campaignRecipients CampaignRecipient[]
  @@index([userId, createdAt])
  @@index([status])
  @@index([referenceType, referenceId])
  @@map("notifications")
}

model NotificationDelivery {
  id                String              @id @default(uuid()) @db.Uuid
  notificationId    String              @map("notification_id") @db.Uuid
  channel           NotificationChannel
  status            NotificationStatus  @default(PENDING)
  provider          String?
  providerMessageId String?             @map("provider_message_id")
  target            String?
  deviceId          String?             @map("device_id") @db.Uuid
  attempts          Int                 @default(0) @db.SmallInt
  errorCode         String?             @map("error_code")
  errorMessage      String?             @map("error_message")
  sentAt            DateTime?           @map("sent_at")
  deliveredAt       DateTime?           @map("delivered_at")
  createdAt         DateTime            @default(now()) @map("created_at")

  notification      Notification        @relation(fields: [notificationId], references: [id])
  device            UserDevice?         @relation(fields: [deviceId], references: [id])
  @@index([notificationId])
  @@index([status])
  @@map("notification_deliveries")
}

model InAppMessage {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  notificationId String?   @map("notification_id") @db.Uuid
  title          String?
  body           String?
  icon           String?
  deepLink       String?   @map("deep_link")
  isRead         Boolean   @default(false) @map("is_read")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime? @map("expires_at")

  user           User          @relation(fields: [userId], references: [id])
  notification   Notification? @relation(fields: [notificationId], references: [id])
  @@index([userId, createdAt])
  @@map("in_app_messages")
}

model NotificationCampaign {
  id              String               @id @default(uuid()) @db.Uuid
  name            String
  category        NotificationCategory @default(PROMOTIONAL)
  channel         NotificationChannel
  templateId      String?              @map("template_id") @db.Uuid
  segment         Json?
  status          String               @default("DRAFT")
  scheduledAt     DateTime?            @map("scheduled_at")
  totalRecipients Int                  @default(0) @map("total_recipients")
  sentCount       Int                  @default(0) @map("sent_count")
  createdBy       String?              @map("created_by") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at")

  template        NotificationTemplate? @relation(fields: [templateId], references: [id])
  recipients      CampaignRecipient[]
  @@index([status, scheduledAt])
  @@map("notification_campaigns")
}

model CampaignRecipient {
  id             String             @id @default(uuid()) @db.Uuid
  campaignId     String             @map("campaign_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  notificationId String?            @map("notification_id") @db.Uuid
  status         NotificationStatus @default(PENDING)
  createdAt      DateTime           @default(now()) @map("created_at")

  campaign       NotificationCampaign @relation(fields: [campaignId], references: [id])
  user           User                 @relation(fields: [userId], references: [id])
  notification   Notification?        @relation(fields: [notificationId], references: [id])
  @@unique([campaignId, userId])
  @@index([campaignId])
  @@map("campaign_recipients")
}

model NotificationProviderLog {
  id                String   @id @default(uuid()) @db.Uuid
  provider          String
  eventType         String?  @map("event_type")
  providerMessageId String   @map("provider_message_id")
  payload           Json
  signature         String?
  processed         Boolean  @default(false)
  receivedAt        DateTime @default(now()) @map("received_at")

  @@map("notification_provider_logs")
}




// ============================ PAYMENT ============================

model PaymentInstrument {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  methodType   String   @map("method_type")
  gateway      String?
  gatewayToken String?  @map("gateway_token")
  brand        String?
  last4        String?  @db.Char(4)
  upiVpa       String?  @map("upi_vpa")
  expiryMonth  Int?     @map("expiry_month") @db.SmallInt
  expiryYear   Int?     @map("expiry_year") @db.SmallInt
  isDefault    Boolean  @default(false) @map("is_default")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id])
  intents      PaymentIntent[]
  @@index([userId])
  @@map("payment_methods")
}

model CustomerWallet {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  balance           Decimal   @default(0) @db.Decimal(12, 2)
  lockedBalance     Decimal   @default(0) @map("locked_balance") @db.Decimal(12, 2)
  currency          String    @default("INR") @db.Char(3)
  lastTransactionAt DateTime? @map("last_transaction_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user              User      @relation(fields: [userId], references: [id])
  transactions      CustomerWalletTransaction[]
  topups            WalletTopup[]
  @@map("customer_wallets")
}

model CustomerWalletTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  walletId      String   @map("wallet_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  txnType       String   @map("txn_type")
  amount        Decimal  @db.Decimal(12, 2)
  balanceAfter  Decimal  @map("balance_after") @db.Decimal(12, 2)
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id") @db.Uuid
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")

  wallet        CustomerWallet @relation(fields: [walletId], references: [id])
  @@index([walletId, createdAt])
  @@map("customer_wallet_transactions")
}

model PaymentIntent {
  id              String   @id @default(uuid()) @db.Uuid
  rideId          String?  @map("ride_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  amount          Decimal  @db.Decimal(10, 2)
  currency        String   @default("INR") @db.Char(3)
  methodType      String   @map("method_type")
  paymentMethodId String?  @map("payment_method_id") @db.Uuid
  status          String   @default("CREATED")
  gateway         String?
  gatewayIntentId String?  @map("gateway_intent_id")
  idempotencyKey  String   @unique @map("idempotency_key")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  ride            Ride?          @relation(fields: [rideId], references: [id])
  user            User           @relation(fields: [userId], references: [id])
  paymentMethod   PaymentInstrument? @relation(fields: [paymentMethodId], references: [id])
  transactions    PaymentTransaction[]
  @@index([rideId])
  @@index([userId])
  @@map("payment_intents")
}

model PaymentTransaction {
  id           String   @id @default(uuid()) @db.Uuid
  intentId     String   @map("intent_id") @db.Uuid
  rideId       String?  @map("ride_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  txnType      String   @map("txn_type")
  amount       Decimal  @db.Decimal(10, 2)
  currency     String   @default("INR") @db.Char(3)
  status       String
  gateway      String?
  gatewayTxnId String?  @map("gateway_txn_id")
  gatewayFee   Decimal  @default(0) @map("gateway_fee") @db.Decimal(10, 2)
  errorCode    String?  @map("error_code")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  intent       PaymentIntent @relation(fields: [intentId], references: [id])
  ride         Ride?         @relation(fields: [rideId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  refunds      Refund[]
  chargebacks  Chargeback[]
  @@index([intentId])
  @@index([rideId])
  @@map("payment_transactions")
}

model GatewayEvent {
  id             String    @id @default(uuid()) @db.Uuid
  gateway        String
  eventType      String    @map("event_type")
  gatewayEventId String    @map("gateway_event_id")
  payload        Json
  signature      String?
  processed      Boolean   @default(false)
  processedAt    DateTime? @map("processed_at")
  receivedAt     DateTime  @default(now()) @map("received_at")

  @@unique([gateway, gatewayEventId])
  @@map("gateway_events")
}

model Refund {
  id              String    @id @default(uuid()) @db.Uuid
  transactionId   String    @map("transaction_id") @db.Uuid
  rideId          String?   @map("ride_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  amount          Decimal   @db.Decimal(10, 2)
  reason          String?
  status          String    @default("PENDING")
  gatewayRefundId String?   @map("gateway_refund_id")
  idempotencyKey  String    @unique @map("idempotency_key")
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  transaction     PaymentTransaction @relation(fields: [transactionId], references: [id])
  ride            Ride?              @relation(fields: [rideId], references: [id])
  user            User               @relation(fields: [userId], references: [id])
  @@index([transactionId])
  @@map("refunds")
}

model PaymentLedgerEntry {
  id            String   @id @default(uuid()) @db.Uuid
  entryGroup    String   @map("entry_group") @db.Uuid
  account       String
  accountRefId  String?  @map("account_ref_id") @db.Uuid
  direction     String   // DEBIT | CREDIT
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("INR") @db.Char(3)
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id") @db.Uuid
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([entryGroup])
  @@index([account, accountRefId, createdAt])
  @@map("payment_ledger_entries")
}

model DriverSettlement {
  id            String   @id @default(uuid()) @db.Uuid
  driverId      String   @map("driver_id") @db.Uuid
  periodStart   DateTime @map("period_start") @db.Date
  periodEnd     DateTime @map("period_end") @db.Date
  grossEarnings Decimal  @default(0) @map("gross_earnings") @db.Decimal(12, 2)
  commission    Decimal  @default(0) @db.Decimal(12, 2)
  adjustments   Decimal  @default(0) @db.Decimal(12, 2)
  netPayable    Decimal  @default(0) @map("net_payable") @db.Decimal(12, 2)
  status        String   @default("PENDING")
  createdAt     DateTime @default(now()) @map("created_at")

  driver        Driver   @relation(fields: [driverId], references: [id])
  payouts       DriverPayout[]
  @@unique([driverId, periodStart, periodEnd])
  @@map("driver_settlements")
}

model DriverPayout {
  id              String    @id @default(uuid()) @db.Uuid
  driverId        String    @map("driver_id") @db.Uuid
  settlementId    String?   @map("settlement_id") @db.Uuid
  bankAccountId   String?   @map("bank_account_id") @db.Uuid
  amount          Decimal   @db.Decimal(12, 2)
  status          String    @default("INITIATED")
  gateway         String?
  gatewayPayoutId String?   @map("gateway_payout_id")
  idempotencyKey  String    @unique @map("idempotency_key")
  failureReason   String?   @map("failure_reason")
  initiatedAt     DateTime  @default(now()) @map("initiated_at")
  completedAt     DateTime? @map("completed_at")

  driver          Driver             @relation(fields: [driverId], references: [id])
  settlement      DriverSettlement?  @relation(fields: [settlementId], references: [id])
  bankAccount     DriverBankAccount? @relation(fields: [bankAccountId], references: [id])
  items           PayoutItem[]
  @@index([driverId])
  @@map("driver_payouts")
}

model PayoutItem {
  id        String   @id @default(uuid()) @db.Uuid
  payoutId  String   @map("payout_id") @db.Uuid
  rideId    String?  @map("ride_id") @db.Uuid
  itemType  String   @map("item_type")
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  payout    DriverPayout @relation(fields: [payoutId], references: [id])
  ride      Ride?        @relation(fields: [rideId], references: [id])
  @@index([payoutId])
  @@map("payout_items")
}

model Chargeback {
  id             String    @id @default(uuid()) @db.Uuid
  transactionId  String    @map("transaction_id") @db.Uuid
  rideId         String?   @map("ride_id") @db.Uuid
  amount         Decimal   @db.Decimal(10, 2)
  reasonCode     String?   @map("reason_code")
  status         String    @default("OPEN")
  gatewayCaseId  String?   @map("gateway_case_id")
  evidenceDueAt  DateTime? @map("evidence_due_at")
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  transaction    PaymentTransaction @relation(fields: [transactionId], references: [id])
  ride           Ride?              @relation(fields: [rideId], references: [id])
  @@index([transactionId])
  @@index([status])
  @@map("chargebacks")
}




// ============================ PRICING ============================

model PricingRule {
  id              String    @id @default(uuid()) @db.Uuid
  vehicleTypeId   String    @map("vehicle_type_id") @db.Uuid
  cityCode        String    @map("city_code")
  currency        String    @default("INR") @db.Char(3)
  baseFare        Decimal   @map("base_fare") @db.Decimal(10, 2)
  minimumFare     Decimal   @map("minimum_fare") @db.Decimal(10, 2)
  perKmRate       Decimal   @map("per_km_rate") @db.Decimal(10, 2)
  perMinuteRate   Decimal   @map("per_minute_rate") @db.Decimal(10, 2)
  freeWaitingMin  Int       @default(3) @map("free_waiting_min") @db.SmallInt
  waitingPerMin   Decimal   @default(0) @map("waiting_per_min") @db.Decimal(10, 2)
  includedKm      Decimal   @default(0) @map("included_km") @db.Decimal(6, 2)
  bookingFee      Decimal   @default(0) @map("booking_fee") @db.Decimal(10, 2)
  platformFeePct  Decimal   @default(0) @map("platform_fee_pct") @db.Decimal(5, 2)
  nightMultiplier Decimal   @default(1.0) @map("night_multiplier") @db.Decimal(4, 2)
  version         Int       @default(1)
  isActive        Boolean   @default(true) @map("is_active")
  effectiveFrom   DateTime  @default(now()) @map("effective_from")
  effectiveTo     DateTime? @map("effective_to")
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")

  vehicleType     VehicleType @relation(fields: [vehicleTypeId], references: [id])
