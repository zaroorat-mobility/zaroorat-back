// ============================ ADMIN ============================

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  permissions RolePermission[]
  assignments UserRoleAssignment[]
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles       RolePermission[]
  @@map("permissions")
}

model RolePermission {
  id           String           @id @default(uuid()) @db.Uuid
  roleId       String           @map("role_id") @db.Uuid
  permissionId String           @map("permission_id") @db.Uuid
  effect       PermissionEffect @default(ALLOW)

  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  grantedBy String?   @map("granted_by") @db.Uuid
  grantedAt DateTime  @default(now()) @map("granted_at")
  expiresAt DateTime? @map("expires_at")

  user      User @relation(fields: [userId], references: [id])
  role      Role @relation(fields: [roleId], references: [id])
  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

model AdminActivityLog {
  id         String      @id @default(uuid()) @db.Uuid
  actorId    String?     @map("actor_id") @db.Uuid
  action     AuditAction
  entityType String?     @map("entity_type")
  entityId   String?     @map("entity_id") @db.Uuid
  summary    String?
  ipAddress  String?     @map("ip_address") @db.Inet
  userAgent  String?     @map("user_agent")
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at")

  actor      User?              @relation(fields: [actorId], references: [id])
  fieldChanges AuditFieldChange[]
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("admin_activity_logs")
}

model AuditFieldChange {
  id            String  @id @default(uuid()) @db.Uuid
  activityLogId String  @map("activity_log_id") @db.Uuid
  fieldName     String  @map("field_name")
  oldValue      String? @map("old_value")
  newValue      String? @map("new_value")

  activityLog   AdminActivityLog @relation(fields: [activityLogId], references: [id])
  @@index([activityLogId])
  @@map("audit_field_changes")
}

model SystemSetting {
  id          String      @id @default(uuid()) @db.Uuid
  key         String      @unique
  value       String?
  valueType   SettingType @default(STRING) @map("value_type")
  category    String?
  description String?
  isSecret    Boolean     @default(false) @map("is_secret")
  version     Int         @default(1)
  updatedBy   String?     @map("updated_by") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([category])
  @@map("system_settings")
}

model FeatureFlag {
  id                String            @id @default(uuid()) @db.Uuid
  key               String            @unique
  name              String?
  description       String?
  status            FeatureFlagStatus @default(OFF)
  rolloutPercentage Int               @default(0) @map("rollout_percentage") @db.SmallInt
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  overrides         FeatureFlagOverride[]
  @@map("feature_flags")
}

model FeatureFlagOverride {
  id          String   @id @default(uuid()) @db.Uuid
  flagId      String   @map("flag_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  segmentCode String?  @map("segment_code")
  enabled     Boolean
  createdAt   DateTime @default(now()) @map("created_at")

  flag        FeatureFlag @relation(fields: [flagId], references: [id])
  user        User?       @relation(fields: [userId], references: [id])
  @@index([flagId])
  @@index([userId])
  @@map("feature_flag_overrides")
}

model AdminSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  ipAddress   String?   @map("ip_address") @db.Inet
  userAgent   String?   @map("user_agent")
  mfaVerified Boolean   @default(false) @map("mfa_verified")
  startedAt   DateTime  @default(now()) @map("started_at")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")

  user        User @relation(fields: [userId], references: [id])
  @@index([userId])
  @@map("admin_sessions")
}

model ApiKey {
  id         String       @id @default(uuid()) @db.Uuid
  name       String
  keyHash    String       @map("key_hash")
  prefix     String?
  scopes     Json?
  status     ApiKeyStatus @default(ACTIVE)
  createdBy  String?      @map("created_by") @db.Uuid
  lastUsedAt DateTime?    @map("last_used_at")
  expiresAt  DateTime?    @map("expires_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([prefix])
  @@map("api_keys")
}

model IpAllowlistEntry {
  id        String   @id @default(uuid()) @db.Uuid
  cidr      String   @db.Inet
  label     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ip_allowlist")
}


// ============================ SYSTEM ============================
// Note: geography columns are Unsupported(...); managed for indexing via raw SQL.

model City {
  id         String    @id @default(uuid()) @db.Uuid
  code       String    @unique
  name       String
  state      String?
  country    String    @default("India")
  timezone   String    @default("Asia/Kolkata")
  currency   String    @default("INR") @db.Char(3)
  center     Unsupported("geography(Point,4326)")?
  boundary   Unsupported("geography(Polygon,4326)")?
  isActive   Boolean   @default(true) @map("is_active")
  launchedAt DateTime? @map("launched_at") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at")

  zones      ServiceZone[]
  @@map("cities")
}

model ServiceZone {
  id        String   @id @default(uuid()) @db.Uuid
  cityId    String   @map("city_id") @db.Uuid
  code      String
  name      String
  zoneType  String   @default("SERVICE") @map("zone_type")
  boundary  Unsupported("geography(Polygon,4326)")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  city      City     @relation(fields: [cityId], references: [id])
  @@index([cityId])
  @@map("service_zones")
}

model AppVersion {
  id          String      @id @default(uuid()) @db.Uuid
  platform    AppPlatform
  version     String
  buildNumber Int?        @map("build_number")
  isSupported Boolean     @default(true) @map("is_supported")
  forceUpdate Boolean     @default(false) @map("force_update")
  changelog   String?
  releasedAt  DateTime?   @map("released_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@unique([platform, version])
  @@map("app_versions")
}

model JobQueue {
  id          String    @id @default(uuid()) @db.Uuid
  jobType     String    @map("job_type")
  payload     Json?
  status      JobStatus @default(QUEUED)
  priority    Int       @default(0) @db.SmallInt
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  runAt       DateTime  @default(now()) @map("run_at")
  lockedAt    DateTime? @map("locked_at")
  lockedBy    String?   @map("locked_by")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@map("job_queue")
}

model ScheduledJob {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @unique
  cronExpression String    @map("cron_expression")
  jobType        String    @map("job_type")
  payload        Json?
  isActive       Boolean   @default(true) @map("is_active")
  lastRunAt      DateTime? @map("last_run_at")
  nextRunAt      DateTime? @map("next_run_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("scheduled_jobs")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id") @db.Uuid
  eventType     String       @map("event_type")
  payload       Json
  status        OutboxStatus @default(PENDING)
  retries       Int          @default(0)
  publishedAt   DateTime?    @map("published_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@map("outbox_events")
}

model WebhookEndpoint {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  url        String
  secret     String?
  eventTypes String[] @map("event_types")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  deliveries WebhookDelivery[]
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id           String                @id @default(uuid()) @db.Uuid
  endpointId   String                @map("endpoint_id") @db.Uuid
  eventType    String                @map("event_type")
  payload      Json
  status       WebhookDeliveryStatus @default(PENDING)
  attempts     Int                   @default(0)
  responseCode Int?                  @map("response_code")
  responseBody String?               @map("response_body")
  nextRetryAt  DateTime?             @map("next_retry_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  deliveredAt  DateTime?             @map("delivered_at")

  endpoint     WebhookEndpoint       @relation(fields: [endpointId], references: [id])
  @@index([endpointId])
  @@map("webhook_deliveries")
}

model IdempotencyKey {
  id          String    @id @default(uuid()) @db.Uuid
  key         String
  scope       String
  requestHash String?   @map("request_hash")
  response    Json?
  status      String    @default("IN_PROGRESS")
  lockedAt    DateTime? @map("locked_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model RateLimitRule {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  scope         String
  limitCount    Int      @map("limit_count")
  windowSeconds Int      @map("window_seconds")
  action        String   @default("BLOCK")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("rate_limit_rules")
}

model MaintenanceWindow {
  id               String   @id @default(uuid()) @db.Uuid
  title            String
  description      String?
  affectedServices String[] @map("affected_services")
  startsAt         DateTime @map("starts_at")
  endsAt           DateTime @map("ends_at")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("maintenance_windows")
}

model DataRetentionPolicy {
  id            String    @id @default(uuid()) @db.Uuid
  tableName     String    @unique @map("table_name")
  retentionDays Int       @map("retention_days")
  strategy      String    @default("DELETE")
  isActive      Boolean   @default(true) @map("is_active")
  lastRunAt     DateTime? @map("last_run_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("data_retention_policies")
}



// ============================ ANALYTICS ============================
// Note: analytics_events is RANGE-partitioned — managed via raw SQL, not Prisma.

model EventType {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  category    String?
  description String?
  schema      Json?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("event_types")
}

model DailyMetric {
  id          String            @id @default(uuid()) @db.Uuid
  metricDate  DateTime          @map("metric_date") @db.Date
  metricKey   String            @map("metric_key")
  cityCode    String?           @map("city_code")
  granularity MetricGranularity @default(DAILY)
  value       Decimal           @default(0) @db.Decimal(18, 4)
  count       BigInt            @default(0)
  createdAt   DateTime          @default(now()) @map("created_at")

  @@unique([metricDate, metricKey, cityCode])
  @@index([metricKey, metricDate])
  @@map("daily_metrics")
}

model Funnel {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  steps       FunnelStep[]
  @@map("funnels")
}

model FunnelStep {
  id            String   @id @default(uuid()) @db.Uuid
  funnelId      String   @map("funnel_id") @db.Uuid
  stepOrder     Int      @map("step_order") @db.SmallInt
  name          String
  eventTypeCode String   @map("event_type_code")
  createdAt     DateTime @default(now()) @map("created_at")

  funnel        Funnel   @relation(fields: [funnelId], references: [id])
  @@unique([funnelId, stepOrder])
  @@map("funnel_steps")
}

model Cohort {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  name       String
  definition Json?
  cohortDate DateTime @map("cohort_date") @db.Date
  size       Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  retention  CohortRetention[]
  @@map("cohorts")
}

model CohortRetention {
  id            String   @id @default(uuid()) @db.Uuid
  cohortId      String   @map("cohort_id") @db.Uuid
  periodNumber  Int      @map("period_number") @db.SmallInt
  retainedCount Int      @default(0) @map("retained_count")
  retentionRate Decimal  @default(0) @map("retention_rate") @db.Decimal(5, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  cohort        Cohort   @relation(fields: [cohortId], references: [id])
  @@unique([cohortId, periodNumber])
  @@map("cohort_retention")
}

model KpiSnapshot {
  id          String            @id @default(uuid()) @db.Uuid
  snapshotAt  DateTime          @map("snapshot_at")
  granularity MetricGranularity @default(DAILY)
  cityCode    String?           @map("city_code")
  kpis        Json
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([snapshotAt])
  @@map("kpi_snapshots")
}

model DashboardWidget {
  id           String   @id @default(uuid()) @db.Uuid
  dashboardKey String   @map("dashboard_key")
  title        String
  widgetType   String   @map("widget_type")
  query        Json
  position     Int?     @default(0) @db.SmallInt
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([dashboardKey])
  @@map("dashboard_widgets")
}

model ReportExport {
  id          String       @id @default(uuid()) @db.Uuid
  reportType  String       @map("report_type")
  params      Json?
  format      ReportFormat @default(CSV)
  status      ReportStatus @default(PENDING)
  fileUrl     String?      @map("file_url")
  rowCount    Int?         @map("row_count")
  requestedBy String?      @map("requested_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  completedAt DateTime?    @map("completed_at")

  @@index([status])
  @@map("report_exports")
}




// ============================ DRIVER ============================

model Driver {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  driverCode         String   @unique @map("driver_code")
  onboardingStatus   DriverOnboardingStatus   @default(PENDING) @map("onboarding_status")
  verificationStatus DriverVerificationStatus @default(PENDING) @map("verification_status")
  currentVehicleId   String?  @map("current_vehicle_id") @db.Uuid
  rating             Decimal  @default(5.0) @db.Decimal(3, 2)
  totalRides         Int      @default(0) @map("total_rides")
  totalDistanceKm    Decimal  @default(0) @map("total_distance_km") @db.Decimal(10, 2)
  totalEarnings      Decimal  @default(0) @map("total_earnings") @db.Decimal(12, 2)
  isAvailable        Boolean  @default(false) @map("is_available")
  isSuspended        Boolean  @default(false) @map("is_suspended")
  approvedAt         DateTime? @map("approved_at")
  approvedBy         String?  @map("approved_by") @db.Uuid
  rejectionReason    String?  @map("rejection_reason")
  lastRideAt         DateTime? @map("last_ride_at")
  acceptanceRate     Decimal? @map("acceptance_rate") @db.Decimal(5, 2)
  completionRate     Decimal? @map("completion_rate") @db.Decimal(5, 2)
  cancellationRate   Decimal? @map("cancellation_rate") @db.Decimal(5, 2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  user               User     @relation(fields: [userId], references: [id])
  profile            DriverProfile?
  documents          DriverDocument[]
  bankAccounts       DriverBankAccount[]
  wallet             DriverWallet?
  onlineStatus       DriverOnlineStatus?
  location           DriverLocation?
  shiftLogs          DriverShiftLog[]
  assignments        VehicleAssignment[]
  dispatches         RideDispatch[]
  rides              Ride[]
  settlements        DriverSettlement[]
  payouts            DriverPayout[]
  withdrawalRequests WithdrawalRequest[]
  ratingAggregate    DriverRatingAggregate?

  @@index([verificationStatus])
  @@index([isAvailable])
  @@map("drivers")
}

model DriverProfile {
