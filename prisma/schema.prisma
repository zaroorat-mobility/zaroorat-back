  updatedAt          DateTime  @updatedAt @map("updated_at")

  driver             Driver    @relation(fields: [driverId], references: [id])

  @@index([driverId])
  @@index([documentType])
  @@index([expiresAt])
  @@map("driver_documents")
}

model DriverBankAccount {
  id                 String   @id @default(uuid()) @db.Uuid
  driverId           String   @map("driver_id") @db.Uuid
  accountHolderName  String?  @map("account_holder_name")
  bankName           String?  @map("bank_name")
  ifscCode           String?  @map("ifsc_code")
  accountNumberEnc   String?  @map("account_number_enc")
  upiId              String?  @map("upi_id")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime? @map("verified_at")
  verifiedBy         String?  @map("verified_by") @db.Uuid
  payoutEnabled      Boolean  @default(false) @map("payout_enabled")
  providerFundAccountId String? @map("provider_fund_account_id")
  beneficiaryId      String?  @map("beneficiary_id")
  isDefault          Boolean  @default(false) @map("is_default")
  createdAt          DateTime @default(now()) @map("created_at")

  driver             Driver   @relation(fields: [driverId], references: [id])
  payouts            DriverPayout[]
  withdrawalRequests WithdrawalRequest[]
  @@index([driverId])
  @@map("driver_bank_accounts")
}

model DriverWallet {
  id                String    @id @default(uuid()) @db.Uuid
  driverId          String    @unique @map("driver_id") @db.Uuid
  balance           Decimal   @default(0) @db.Decimal(12, 2)
  lockedBalance     Decimal   @default(0) @map("locked_balance") @db.Decimal(12, 2)
  currency          String    @default("INR") @db.Char(3)
  lastTransactionAt DateTime? @map("last_transaction_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  driver            Driver    @relation(fields: [driverId], references: [id])
  transactions      DriverWalletTransaction[]
  withdrawals       WithdrawalRequest[]
  @@map("driver_wallets")
}

model DriverWalletTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  walletId      String   @map("wallet_id") @db.Uuid
  driverId      String   @map("driver_id") @db.Uuid
  txnType       DriverWalletTxnType @map("txn_type")
  amount        Decimal  @db.Decimal(12, 2)
  balanceAfter  Decimal  @map("balance_after") @db.Decimal(12, 2)
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id") @db.Uuid
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")

  wallet        DriverWallet @relation(fields: [walletId], references: [id])
  @@index([walletId])
  @@index([driverId, createdAt])
  @@map("driver_wallet_transactions")
}

model DriverOnlineStatus {
  driverId       String        @id @map("driver_id") @db.Uuid
  status         DriverStatus  @default(OFFLINE)
  lastOnlineAt   DateTime?     @map("last_online_at")
  lastOfflineAt  DateTime?     @map("last_offline_at")
  currentShiftId String?       @map("current_shift_id") @db.Uuid
  heartbeatAt    DateTime?     @map("heartbeat_at")
  batteryLevel   Int?          @map("battery_level") @db.SmallInt
  networkType    String?       @map("network_type")
  appVersion     String?       @map("app_version")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  driver         Driver        @relation(fields: [driverId], references: [id])
  @@map("driver_online_status")
}

model DriverLocation {
  driverId       String   @id @map("driver_id") @db.Uuid
  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)
  location       Unsupported("geography(Point,4326)")
  heading        Decimal? @db.Decimal(5, 2)
  bearing        Decimal? @db.Decimal(5, 2)
  speedKmh       Decimal? @map("speed_kmh") @db.Decimal(6, 2)
  accuracyMeters Decimal? @map("accuracy_meters") @db.Decimal(6, 2)
  altitude       Decimal? @db.Decimal(8, 2)
  provider       String?
  gpsSource      String?  @map("gps_source")
  isMockLocation Boolean  @default(false) @map("is_mock_location")
  rideId         String?  @map("ride_id") @db.Uuid
  recordedAt     DateTime @map("recorded_at")

  driver         Driver   @relation(fields: [driverId], references: [id])
  @@map("driver_locations")
}

model DriverShiftLog {
  id                 String    @id @default(uuid()) @db.Uuid
  driverId           String    @map("driver_id") @db.Uuid
  shiftStart         DateTime  @map("shift_start")
  shiftEnd           DateTime? @map("shift_end")
  totalOnlineMinutes Int       @default(0) @map("total_online_minutes")
  totalTripMinutes   Int       @default(0) @map("total_trip_minutes")
  idleMinutes        Int       @default(0) @map("idle_minutes")
  completedRides     Int       @default(0) @map("completed_rides")
  acceptedTrips      Int       @default(0) @map("accepted_trips")
  rejectedTrips      Int       @default(0) @map("rejected_trips")
  cancelledTrips     Int       @default(0) @map("cancelled_trips")
  distanceDrivenKm   Decimal   @default(0) @map("distance_driven_km") @db.Decimal(10, 2)
  earnings           Decimal   @default(0) @db.Decimal(12, 2)
