  addressLine       String?   @map("address_line")
  city              String?
  state             String?
  country           String?   @default("India")
  postalCode        String?   @map("postal_code")
  preferredLanguage String?   @default("en") @map("preferred_language")
  bloodGroup        String?   @map("blood_group")
  profilePhoto      String?   @map("profile_photo")
  alternatePhone    String?   @map("alternate_phone")
  drivingExperienceYears Int? @map("driving_experience_years") @db.SmallInt
  spokenLanguages   String[]  @map("spoken_languages")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  driver            Driver    @relation(fields: [driverId], references: [id])
  @@map("driver_profiles")
}

model DriverDocument {
  id                 String    @id @default(uuid()) @db.Uuid
  driverId           String    @map("driver_id") @db.Uuid
  documentType       DriverDocumentType @map("document_type")
  documentNumber     String?   @map("document_number")
