// ============================ PROMOTIONS ============================

model PromoCampaign {
  id        String            @id @default(uuid()) @db.Uuid
  code      String            @unique
  name      String
  objective CampaignObjective @default(ACQUISITION)
  status    CampaignStatus    @default(DRAFT)
  budget    Decimal?          @db.Decimal(14, 2)
  spent     Decimal           @default(0) @db.Decimal(14, 2)
  startsAt  DateTime?         @map("starts_at")
  endsAt    DateTime?         @map("ends_at")
  createdBy String?           @map("created_by") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  targets   CampaignTarget[]
  batches   CouponBatch[]
  banners   PromoBanner[]
  @@index([status, startsAt])
  @@map("promo_campaigns")
}

model AudienceSegment {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  name          String
  description   String?
  rules         Json?
  estimatedSize Int?     @map("estimated_size")
  isDynamic     Boolean  @default(true) @map("is_dynamic")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  targets       CampaignTarget[]
  @@map("audience_segments")
}

model CampaignTarget {
  id          String   @id @default(uuid()) @db.Uuid
  campaignId  String   @map("campaign_id") @db.Uuid
  segmentId   String   @map("segment_id") @db.Uuid
  promotionId String?  @map("promotion_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  campaign    PromoCampaign   @relation(fields: [campaignId], references: [id])
  segment     AudienceSegment @relation(fields: [segmentId], references: [id])
  promotion   Promotion?      @relation(fields: [promotionId], references: [id])
  @@unique([campaignId, segmentId])
  @@index([segmentId])
  @@map("campaign_targets")
}

model CouponBatch {
  id             String    @id @default(uuid()) @db.Uuid
  campaignId     String?   @map("campaign_id") @db.Uuid
  promotionId    String    @map("promotion_id") @db.Uuid
  name           String?
  prefix         String?
  totalCount     Int       @default(0) @map("total_count")
  generatedCount Int       @default(0) @map("generated_count")
  perUserLimit   Int       @default(1) @map("per_user_limit") @db.SmallInt
  expiresAt      DateTime? @map("expires_at")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")

  campaign       PromoCampaign? @relation(fields: [campaignId], references: [id])
  promotion      Promotion      @relation(fields: [promotionId], references: [id])
  coupons        Coupon[]
  @@index([campaignId])
  @@map("coupon_batches")
}

model Coupon {
  id             String       @id @default(uuid()) @db.Uuid
  batchId        String       @map("batch_id") @db.Uuid
  code           String       @unique
  userId         String?      @map("user_id") @db.Uuid
  status         CouponStatus @default(ACTIVE)
  redeemedRideId String?      @map("redeemed_ride_id") @db.Uuid
  assignedAt     DateTime?    @map("assigned_at")
  redeemedAt     DateTime?    @map("redeemed_at")
  expiresAt      DateTime?    @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  batch          CouponBatch  @relation(fields: [batchId], references: [id])
  user           User?        @relation(fields: [userId], references: [id])
  redeemedRide   Ride?        @relation(fields: [redeemedRideId], references: [id])
  @@index([batchId])
  @@index([userId])
  @@index([status])
  @@map("coupons")
}

model PromoBanner {
  id         String          @id @default(uuid()) @db.Uuid
  campaignId String?         @map("campaign_id") @db.Uuid
  title      String?
  imageUrl   String          @map("image_url")
  placement  BannerPlacement @default(HOME)
  actionUrl  String?         @map("action_url")
  priority   Int             @default(0) @db.SmallInt
  startsAt   DateTime?       @map("starts_at")
  endsAt     DateTime?       @map("ends_at")
  isActive   Boolean         @default(true) @map("is_active")
  createdAt  DateTime        @default(now()) @map("created_at")

  campaign   PromoCampaign?  @relation(fields: [campaignId], references: [id])
  @@map("promo_banners")
}




// ============================ REFERRAL ============================

model ReferralProgram {
  id                  String   @id @default(uuid()) @db.Uuid
  code                String   @unique
  name                String?
  referrerReward      Decimal  @default(0) @map("referrer_reward") @db.Decimal(10, 2)
  refereeReward       Decimal  @default(0) @map("referee_reward") @db.Decimal(10, 2)
  rewardType          String   @default("WALLET") @map("reward_type")
  qualifyingEvent     String   @default("FIRST_RIDE") @map("qualifying_event")
  qualifyingThreshold Int      @default(1) @map("qualifying_threshold") @db.SmallInt
  maxReferralsPerUser Int?     @map("max_referrals_per_user")
  rewardExpiryDays    Int?     @map("reward_expiry_days")
  validFrom           DateTime @map("valid_from")
  validTo             DateTime @map("valid_to")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")

  codes               ReferralCode[]
  referrals           Referral[]
  milestones          ReferralMilestone[]
  @@index([isActive, validFrom, validTo])
  @@map("referral_programs")
}

model ReferralCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  programId String   @map("program_id") @db.Uuid
  code      String   @unique
  usesCount Int      @default(0) @map("uses_count")
  maxUses   Int?     @map("max_uses")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  user      User            @relation(fields: [userId], references: [id])
  program   ReferralProgram @relation(fields: [programId], references: [id])
  referrals Referral[]
  @@unique([userId, programId])
  @@index([userId])
  @@map("referral_codes")
}

model Referral {
  id              String         @id @default(uuid()) @db.Uuid
  programId       String         @map("program_id") @db.Uuid
  referrerId      String         @map("referrer_id") @db.Uuid
  refereeId       String?        @map("referee_id") @db.Uuid
  referralCodeId  String?        @map("referral_code_id") @db.Uuid
  status          ReferralStatus @default(PENDING)
  qualifyingRides Int            @default(0) @map("qualifying_rides")
  signedUpAt      DateTime?      @map("signed_up_at")
  qualifiedAt     DateTime?      @map("qualified_at")
  rewardedAt      DateTime?      @map("rewarded_at")
  expiresAt       DateTime?      @map("expires_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  program         ReferralProgram @relation(fields: [programId], references: [id])
  referrer        User            @relation("Referrer", fields: [referrerId], references: [id])
  referee         User?           @relation("Referee", fields: [refereeId], references: [id])
  referralCode    ReferralCode?   @relation(fields: [referralCodeId], references: [id])
  rewards         ReferralReward[]
  fraudFlags      ReferralFraudFlag[]
  @@unique([programId, refereeId])
  @@index([referrerId])
  @@index([status])
  @@map("referrals")
}

model ReferralReward {
  id                  String                    @id @default(uuid()) @db.Uuid
  referralId          String                    @map("referral_id") @db.Uuid
  beneficiary         ReferralRewardBeneficiary
  userId              String                    @map("user_id") @db.Uuid
  amount              Decimal                   @db.Decimal(10, 2)
  rewardType          String                    @default("WALLET") @map("reward_type")
  status              ReferralRewardStatus      @default(PENDING)
  walletTransactionId String?                   @map("wallet_transaction_id") @db.Uuid
  creditedAt          DateTime?                 @map("credited_at")
  expiresAt           DateTime?                 @map("expires_at")
  createdAt           DateTime                  @default(now()) @map("created_at")

  referral            Referral @relation(fields: [referralId], references: [id])
  user                User     @relation(fields: [userId], references: [id])
  @@index([referralId])
  @@index([userId])
  @@map("referral_rewards")
}

model ReferralMilestone {
  id                String   @id @default(uuid()) @db.Uuid
  programId         String   @map("program_id") @db.Uuid
  name              String
  requiredReferrals Int      @map("required_referrals")
  bonusAmount       Decimal  @map("bonus_amount") @db.Decimal(10, 2)
  rewardType        String   @default("WALLET") @map("reward_type")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")

  program           ReferralProgram @relation(fields: [programId], references: [id])
  @@index([programId])
  @@map("referral_milestones")
}

model ReferralFraudFlag {
  id         String              @id @default(uuid()) @db.Uuid
  referralId String              @map("referral_id") @db.Uuid
  reason     String
  status     ReferralFraudStatus @default(SUSPECTED)
  details    Json?
  reviewedBy String?             @map("reviewed_by") @db.Uuid
  createdAt  DateTime            @default(now()) @map("created_at")
  resolvedAt DateTime?           @map("resolved_at")

  referral   Referral @relation(fields: [referralId], references: [id])
  reviewer   User?    @relation(fields: [reviewedBy], references: [id])
  @@index([referralId])
  @@map("referral_fraud_flags")
}




// ============================ RIDE ============================

model RideRequest {
  id                   String    @id @default(uuid()) @db.Uuid
  customerId           String    @map("customer_id") @db.Uuid
  vehicleTypeId        String    @map("vehicle_type_id") @db.Uuid
  pickupLat            Decimal   @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng            Decimal   @map("pickup_lng") @db.Decimal(10, 7)
  pickupLocation       Unsupported("geography(Point,4326)") @map("pickup_location")
  pickupAddress        String?   @map("pickup_address")
  dropLat              Decimal?  @map("drop_lat") @db.Decimal(10, 7)
  dropLng              Decimal?  @map("drop_lng") @db.Decimal(10, 7)
  dropLocation         Unsupported("geography(Point,4326)")? @map("drop_location")
  dropAddress          String?   @map("drop_address")
  estimatedDistanceKm  Decimal?  @map("estimated_distance_km") @db.Decimal(8, 2)
  estimatedDurationMin Int?      @map("estimated_duration_min")
  quotedFare           Decimal?  @map("quoted_fare") @db.Decimal(10, 2)
  surgeMultiplier      Decimal   @default(1.0) @map("surge_multiplier") @db.Decimal(4, 2)
  paymentMethod        String?   @map("payment_method")
  promoCode            String?   @map("promo_code")
  scheduledFor         DateTime? @map("scheduled_for")
  status               RideRequestStatus @default(CREATED)
  rideId               String?   @map("ride_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at")
  expiresAt            DateTime? @map("expires_at")

  vehicleType          VehicleType @relation(fields: [vehicleTypeId], references: [id])
  dispatches           RideDispatch[]
  rides                Ride[]
  scheduledRides       ScheduledRide[]

  @@index([customerId])
  @@index([status])
  @@map("ride_requests")
}

model RideDispatch {
  id               String    @id @default(uuid()) @db.Uuid
  requestId        String    @map("request_id") @db.Uuid
  driverId         String    @map("driver_id") @db.Uuid
  vehicleId        String?   @map("vehicle_id") @db.Uuid
  offeredAt        DateTime  @default(now()) @map("offered_at")
  respondedAt      DateTime? @map("responded_at")
  response         DispatchResponse @default(PENDING)
  rejectReason     String?   @map("reject_reason")
  driverDistanceM  Int?      @map("driver_distance_m")
  driverEtaSeconds Int?      @map("driver_eta_seconds")
  dispatchRound    Int       @default(1) @map("dispatch_round") @db.SmallInt
  expiresAt        DateTime? @map("expires_at")

  request          RideRequest @relation(fields: [requestId], references: [id])
  driver           Driver      @relation(fields: [driverId], references: [id])
  vehicle          Vehicle?    @relation(fields: [vehicleId], references: [id])

  @@unique([requestId, driverId])
  @@index([driverId])
  @@index([response])
  @@map("ride_dispatches")
}

model Ride {
  id                String    @id @default(uuid()) @db.Uuid
  rideCode          String    @unique @map("ride_code")
  requestId         String    @map("request_id") @db.Uuid
  customerId        String    @map("customer_id") @db.Uuid
  driverId          String    @map("driver_id") @db.Uuid
  vehicleId         String    @map("vehicle_id") @db.Uuid
  vehicleTypeId     String    @map("vehicle_type_id") @db.Uuid
  status            RideStatus    @default(ACCEPTED)
  paymentMethod     PaymentMethod @map("payment_method")
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  pickupLocation    Unsupported("geography(Point,4326)") @map("pickup_location")
  pickupAddress     String?   @map("pickup_address")
  dropLocation      Unsupported("geography(Point,4326)")? @map("drop_location")
  dropAddress       String?   @map("drop_address")
  acceptedAt        DateTime  @default(now()) @map("accepted_at")
  arrivedAt         DateTime? @map("arrived_at")
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  cancelledAt       DateTime? @map("cancelled_at")
  actualDistanceKm  Decimal?  @map("actual_distance_km") @db.Decimal(8, 2)
  actualDurationMin Int?      @map("actual_duration_min")
  waitTimeMin       Int       @default(0) @map("wait_time_min")
  isScheduled       Boolean   @default(false) @map("is_scheduled")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  request           RideRequest @relation(fields: [requestId], references: [id])
  customer          User        @relation("CustomerRides", fields: [customerId], references: [id])
  driver            Driver      @relation(fields: [driverId], references: [id])
  vehicle           Vehicle     @relation(fields: [vehicleId], references: [id])
  vehicleType       VehicleType @relation(fields: [vehicleTypeId], references: [id])

  stops             RideStop[]
  statusEvents      RideStatusEvent[]
  fare              RideFare?
  fareLines         RideFareLine[]
  cancellation      RideCancellation?
  otps              RideOtp[]
  receipt           RideReceipt?
  payments          RidePayment[]
  ratings           RideRating[]
  promosApplied     RidePromoApplied[]
  routePlan         RideRoutePlan?
  waitEvents        RideWaitEvent[]
  disputes          RideDispute[]
  promoRedemptions  PromotionRedemption[]
  paymentIntents    PaymentIntent[]
  paymentTransactions PaymentTransaction[]
  refunds           Refund[]
  chargebacks       Chargeback[]
  payoutItems       PayoutItem[]
  cashbackGrants    CashbackGrant[]
  chatConversations ChatConversation[]
  supportTickets    SupportTicket[]
  redeemedCoupons   Coupon[]

  @@index([customerId])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
  @@map("rides")
}

model RideStop {
  id         String    @id @default(uuid()) @db.Uuid
  rideId     String    @map("ride_id") @db.Uuid
  sequence   Int       @db.SmallInt
  stopType   String    @map("stop_type")
  location   Unsupported("geography(Point,4326)")
  address    String?
  arrivedAt  DateTime? @map("arrived_at")
  departedAt DateTime? @map("departed_at")

  ride       Ride      @relation(fields: [rideId], references: [id])
  @@unique([rideId, sequence])
  @@map("ride_stops")
}

model RideStatusEvent {
  id         String   @id @default(uuid()) @db.Uuid
  rideId     String   @map("ride_id") @db.Uuid
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  actorType  String?  @map("actor_type")
  actorId    String?  @map("actor_id") @db.Uuid
  reason     String?
  location   Unsupported("geography(Point,4326)")?
  createdAt  DateTime @default(now()) @map("created_at")

  ride       Ride     @relation(fields: [rideId], references: [id])
  @@index([rideId, createdAt])
  @@map("ride_status_events")
}

// NOTE: ride_track_points is RANGE-partitioned — manage via raw SQL, not Prisma.

model RideFare {
  id                 String   @id @default(uuid()) @db.Uuid
  rideId             String   @unique @map("ride_id") @db.Uuid
  currency           String   @default("INR") @db.Char(3)
  baseFare           Decimal  @map("base_fare") @db.Decimal(10, 2)
  distanceFare       Decimal  @map("distance_fare") @db.Decimal(10, 2)
  timeFare           Decimal  @map("time_fare") @db.Decimal(10, 2)
  waitingCharge      Decimal  @default(0) @map("waiting_charge") @db.Decimal(10, 2)
  surgeMultiplier    Decimal  @default(1.0) @map("surge_multiplier") @db.Decimal(4, 2)
  surgeAmount        Decimal  @default(0) @map("surge_amount") @db.Decimal(10, 2)
  subtotal           Decimal  @db.Decimal(10, 2)
  discountAmount     Decimal  @default(0) @map("discount_amount") @db.Decimal(10, 2)
  taxAmount          Decimal  @default(0) @map("tax_amount") @db.Decimal(10, 2)
  tollAmount         Decimal  @default(0) @map("toll_amount") @db.Decimal(10, 2)
  platformFee        Decimal  @default(0) @map("platform_fee") @db.Decimal(10, 2)
  tipAmount          Decimal  @default(0) @map("tip_amount") @db.Decimal(10, 2)
  totalFare          Decimal  @map("total_fare") @db.Decimal(10, 2)
  driverEarning      Decimal  @map("driver_earning") @db.Decimal(10, 2)
  platformCommission Decimal  @map("platform_commission") @db.Decimal(10, 2)
  createdAt          DateTime @default(now()) @map("created_at")

  ride               Ride     @relation(fields: [rideId], references: [id])
  @@map("ride_fares")
}

model RideFareLine {
  id       String  @id @default(uuid()) @db.Uuid
  rideId   String  @map("ride_id") @db.Uuid
  lineType String  @map("line_type")
  label    String?
  amount   Decimal @db.Decimal(10, 2)
  sequence Int?    @db.SmallInt

  ride     Ride    @relation(fields: [rideId], references: [id])
  @@index([rideId])
  @@map("ride_fare_lines")
}

model RideCancellation {
  id                String   @id @default(uuid()) @db.Uuid
  rideId            String   @unique @map("ride_id") @db.Uuid
  cancelledBy       String   @map("cancelled_by")
  actorId           String?  @map("actor_id") @db.Uuid
  reasonCode        String   @map("reason_code")
  reasonText        String?  @map("reason_text")
  cancelledAtStatus String?  @map("cancelled_at_status")
  cancellationFee   Decimal  @default(0) @map("cancellation_fee") @db.Decimal(10, 2)
  feeCharged        Boolean  @default(false) @map("fee_charged")
  createdAt         DateTime @default(now()) @map("created_at")

  ride              Ride     @relation(fields: [rideId], references: [id])
  @@map("ride_cancellations")
}

model RideOtp {
  id         String    @id @default(uuid()) @db.Uuid
  rideId     String    @map("ride_id") @db.Uuid
  otpHash    String    @map("otp_hash")
  purpose    String    @default("START")
  attempts   Int       @default(0) @db.SmallInt
  verified   Boolean   @default(false)
  verifiedAt DateTime? @map("verified_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  ride       Ride      @relation(fields: [rideId], references: [id])
  @@index([rideId])
  @@map("ride_otps")
}

model RideReceipt {
  id            String   @id @default(uuid()) @db.Uuid
  rideId        String   @unique @map("ride_id") @db.Uuid
  receiptNumber String   @unique @map("receipt_number")
  snapshotJson  Json     @map("snapshot_json")
  pdfUrl        String?  @map("pdf_url")
  issuedAt      DateTime @default(now()) @map("issued_at")

  ride          Ride     @relation(fields: [rideId], references: [id])
  @@map("ride_receipts")
}

model RidePayment {
  id        String    @id @default(uuid()) @db.Uuid
  rideId    String    @map("ride_id") @db.Uuid
  paymentId String?   @map("payment_id") @db.Uuid
  amount    Decimal   @db.Decimal(10, 2)
  method    String
  status    String    @default("PENDING")
  settledAt DateTime? @map("settled_at")
  createdAt DateTime  @default(now()) @map("created_at")

  ride      Ride      @relation(fields: [rideId], references: [id])
  @@index([rideId])
  @@map("ride_payments")
}

model RideRating {
  id        String   @id @default(uuid()) @db.Uuid
  rideId    String   @map("ride_id") @db.Uuid
  ratedBy   String   @map("rated_by")
  rating    Int      @db.SmallInt
  tags      String[]
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  ride      Ride     @relation(fields: [rideId], references: [id])
  tagAssignments ReviewTagAssignment[]
  flags     ReviewFlag[]
  response  ReviewResponse?
  @@unique([rideId, ratedBy])
  @@map("ride_ratings")
}

model RidePromoApplied {
  id             String   @id @default(uuid()) @db.Uuid
  rideId         String   @map("ride_id") @db.Uuid
  promoCode      String   @map("promo_code")
  promoId        String?  @map("promo_id") @db.Uuid
  discountAmount Decimal  @map("discount_amount") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  ride           Ride     @relation(fields: [rideId], references: [id])
  @@index([rideId])
  @@map("ride_promos_applied")
}

model ScheduledRide {
  id             String    @id @default(uuid()) @db.Uuid
  requestId      String    @map("request_id") @db.Uuid
  customerId     String    @map("customer_id") @db.Uuid
  scheduledFor   DateTime  @map("scheduled_for")
  status         String    @default("SCHEDULED")
  reminderSentAt DateTime? @map("reminder_sent_at")
  rideId         String?   @map("ride_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  request        RideRequest @relation(fields: [requestId], references: [id])
  @@index([scheduledFor])
  @@map("scheduled_rides")
}

model RideRoutePlan {
  id                 String   @id @default(uuid()) @db.Uuid
  rideId             String   @unique @map("ride_id") @db.Uuid
  encodedPolyline    String?  @map("encoded_polyline")
  plannedDistanceKm  Decimal? @map("planned_distance_km") @db.Decimal(8, 2)
  plannedDurationMin Int?     @map("planned_duration_min")
  createdAt          DateTime @default(now()) @map("created_at")

  ride               Ride     @relation(fields: [rideId], references: [id])
  @@map("ride_route_plan")
}

model RideWaitEvent {
  id            String    @id @default(uuid()) @db.Uuid
  rideId        String    @map("ride_id") @db.Uuid
  startedAt     DateTime  @map("started_at")
  endedAt       DateTime? @map("ended_at")
  billedMinutes Int       @default(0) @map("billed_minutes")
  charge        Decimal   @default(0) @db.Decimal(10, 2)

  ride          Ride      @relation(fields: [rideId], references: [id])
  @@index([rideId])
  @@map("ride_wait_events")
}

model RideDispute {
  id           String    @id @default(uuid()) @db.Uuid
  rideId       String    @map("ride_id") @db.Uuid
  raisedBy     String    @map("raised_by")
  category     String
  description  String?
  status       String    @default("OPEN")
  resolution   String?
  refundAmount Decimal   @default(0) @map("refund_amount") @db.Decimal(10, 2)
  createdAt    DateTime  @default(now()) @map("created_at")
  resolvedAt   DateTime? @map("resolved_at")

  ride         Ride      @relation(fields: [rideId], references: [id])
  @@index([rideId])
  @@index([status])
  @@map("ride_disputes")
}




// ============================ CHAT ============================

model ChatConversation {
  id            String                 @id @default(uuid()) @db.Uuid
  type          ChatConversationType   @default(RIDE)
  rideId        String?                @map("ride_id") @db.Uuid
  status        ChatConversationStatus @default(ACTIVE)
  lastMessageAt DateTime?              @map("last_message_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  closedAt      DateTime?             @map("closed_at")

  ride          Ride?             @relation(fields: [rideId], references: [id])
  participants  ChatParticipant[]
  messages      ChatMessage[]
  reports       ChatReport[]
  @@index([rideId])
  @@index([status, lastMessageAt])
  @@map("chat_conversations")
}

model ChatParticipant {
  id             String              @id @default(uuid()) @db.Uuid
  conversationId String              @map("conversation_id") @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  role           ChatParticipantRole
  joinedAt       DateTime            @default(now()) @map("joined_at")
  lastReadAt     DateTime?           @map("last_read_at")
  isMuted        Boolean             @default(false) @map("is_muted")
  leftAt         DateTime?           @map("left_at")

  conversation   ChatConversation    @relation(fields: [conversationId], references: [id])
  user           User                @relation(fields: [userId], references: [id])
  @@unique([conversationId, userId])
  @@index([userId])
  @@map("chat_participants")
}

model ChatMessage {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @map("conversation_id") @db.Uuid
  senderId       String?           @map("sender_id") @db.Uuid
  messageType    ChatMessageType   @default(TEXT) @map("message_type")
  content        String?
  status         ChatMessageStatus @default(SENT)
  replyToId      String?           @map("reply_to_id") @db.Uuid
  metadata       Json?
  isDeleted      Boolean           @default(false) @map("is_deleted")
  createdAt      DateTime          @default(now()) @map("created_at")
  editedAt       DateTime?         @map("edited_at")

  conversation   ChatConversation  @relation(fields: [conversationId], references: [id])
  sender         User?             @relation(fields: [senderId], references: [id])
  replyTo        ChatMessage?      @relation("MessageReply", fields: [replyToId], references: [id])
  replies        ChatMessage[]     @relation("MessageReply")
  attachments    ChatAttachment[]
  receipts       ChatReadReceipt[]
  reports        ChatReport[]
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("chat_messages")
}

model ChatAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  messageId    String   @map("message_id") @db.Uuid
  mediaType    String   @map("media_type")
  url          String
  thumbnailUrl String?  @map("thumbnail_url")
  sizeBytes    BigInt?  @map("size_bytes")
  durationSec  Int?     @map("duration_sec")
  width        Int?
  height       Int?
  createdAt    DateTime @default(now()) @map("created_at")

  message      ChatMessage @relation(fields: [messageId], references: [id])
  @@index([messageId])
  @@map("chat_attachments")
}

model ChatReadReceipt {
  id          String    @id @default(uuid()) @db.Uuid
  messageId   String    @map("message_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")

  message     ChatMessage @relation(fields: [messageId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  @@unique([messageId, userId])
  @@index([userId])
  @@map("chat_read_receipts")
}

model ChatCannedReply {
  id        String              @id @default(uuid()) @db.Uuid
  role      ChatParticipantRole
  category  String?
  text      String
  locale    String              @default("en")
  sortOrder Int                 @default(0) @map("sort_order") @db.SmallInt
  isActive  Boolean             @default(true) @map("is_active")
  createdAt DateTime            @default(now()) @map("created_at")

  @@map("chat_canned_replies")
}

model ChatBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  blocker   User     @relation("Blocker", fields: [blockerId], references: [id])
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id])
  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("chat_blocks")
}

model ChatReport {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String?   @map("conversation_id") @db.Uuid
  messageId      String?   @map("message_id") @db.Uuid
  reporterId     String    @map("reporter_id") @db.Uuid
  reportedId     String?   @map("reported_id") @db.Uuid
  category       String
  description    String?
  status         String    @default("OPEN")
  createdAt      DateTime  @default(now()) @map("created_at")
  resolvedAt     DateTime? @map("resolved_at")

  conversation   ChatConversation? @relation(fields: [conversationId], references: [id])
  message        ChatMessage?      @relation(fields: [messageId], references: [id])
  reporter       User              @relation("Reporter", fields: [reporterId], references: [id])
  reported       User?             @relation("Reported", fields: [reportedId], references: [id])
  @@index([status])
  @@index([reportedId])
  @@map("chat_reports")
}


// ============================ REVIEW ============================

model RatingTag {
  id         String           @id @default(uuid()) @db.Uuid
  code       String           @unique
  label      String
  targetType RatingTargetType @map("target_type")
  sentiment  RatingSentiment  @default(POSITIVE)
  minStars   Int?             @default(1) @map("min_stars") @db.SmallInt
  maxStars   Int?             @default(5) @map("max_stars") @db.SmallInt
  sortOrder  Int              @default(0) @map("sort_order") @db.SmallInt
  isActive   Boolean          @default(true) @map("is_active")
  createdAt  DateTime         @default(now()) @map("created_at")

  assignments ReviewTagAssignment[]
  @@map("rating_tags")
}

model ReviewTagAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  rideRatingId String   @map("ride_rating_id") @db.Uuid
  tagId        String   @map("tag_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  rideRating   RideRating @relation(fields: [rideRatingId], references: [id])
  tag          RatingTag  @relation(fields: [tagId], references: [id])
  @@unique([rideRatingId, tagId])
  @@index([tagId])
  @@map("review_tag_assignments")
}

model DriverRatingAggregate {
  driverId     String    @id @map("driver_id") @db.Uuid
  avgRating    Decimal   @default(0) @map("avg_rating") @db.Decimal(3, 2)
  totalRatings Int       @default(0) @map("total_ratings")
  star1        Int       @default(0)
  star2        Int       @default(0)
  star3        Int       @default(0)
  star4        Int       @default(0)
  star5        Int       @default(0)
  lastRatedAt  DateTime? @map("last_rated_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  driver       Driver    @relation(fields: [driverId], references: [id])
  @@map("driver_rating_aggregates")
}

model CustomerRatingAggregate {
  userId       String    @id @map("user_id") @db.Uuid
  avgRating    Decimal   @default(0) @map("avg_rating") @db.Decimal(3, 2)
  totalRatings Int       @default(0) @map("total_ratings")
  star1        Int       @default(0)
  star2        Int       @default(0)
  star3        Int       @default(0)
  star4        Int       @default(0)
  star5        Int       @default(0)
  lastRatedAt  DateTime? @map("last_rated_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user         User      @relation(fields: [userId], references: [id])
  @@map("customer_rating_aggregates")
}

model ReviewFlag {
  id            String           @id @default(uuid()) @db.Uuid
  rideRatingId  String           @map("ride_rating_id") @db.Uuid
  flaggedBy     String?          @map("flagged_by") @db.Uuid
  reason        String
  status        ReviewFlagStatus @default(PENDING)
  moderatorId   String?          @map("moderator_id") @db.Uuid
  moderatorNote String?          @map("moderator_note")
  createdAt     DateTime         @default(now()) @map("created_at")
  resolvedAt    DateTime?        @map("resolved_at")

  rideRating    RideRating @relation(fields: [rideRatingId], references: [id])
  flagger       User?      @relation("FlaggedBy", fields: [flaggedBy], references: [id])
  moderator     User?      @relation("Moderator", fields: [moderatorId], references: [id])
  @@index([rideRatingId])
  @@map("review_flags")
}

model ReviewResponse {
  id           String   @id @default(uuid()) @db.Uuid
  rideRatingId String   @unique @map("ride_rating_id") @db.Uuid
  responderId  String   @map("responder_id") @db.Uuid
  responseText String   @map("response_text")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  rideRating   RideRating @relation(fields: [rideRatingId], references: [id])
  responder    User       @relation(fields: [responderId], references: [id])
  @@map("review_responses")
}


// ============================ SUPPORT ============================

model SlaPolicy {
  id                String         @id @default(uuid()) @db.Uuid
  name              String
  priority          TicketPriority
  firstResponseMins Int            @map("first_response_mins")
  resolutionMins    Int            @map("resolution_mins")
  businessHoursOnly Boolean        @default(false) @map("business_hours_only")
  isActive          Boolean        @default(true) @map("is_active")
  createdAt         DateTime       @default(now()) @map("created_at")

  categories        SupportCategory[]
  @@map("sla_policies")
}

model SupportCategory {
  id              String         @id @default(uuid()) @db.Uuid
  code            String         @unique
  name            String
  parentId        String?        @map("parent_id") @db.Uuid
  defaultPriority TicketPriority @default(NORMAL) @map("default_priority")
  slaPolicyId     String?        @map("sla_policy_id") @db.Uuid
  sortOrder       Int            @default(0) @map("sort_order") @db.SmallInt
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at")

  parent          SupportCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children        SupportCategory[] @relation("CategoryTree")
  slaPolicy       SlaPolicy?        @relation(fields: [slaPolicyId], references: [id])
  tickets         SupportTicket[]
  cannedResponses SupportCannedResponse[]
  @@index([parentId])
  @@map("support_categories")
}

model SupportAgent {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @unique @map("user_id") @db.Uuid
  displayName   String?     @map("display_name")
  status        AgentStatus @default(OFFLINE)
  maxConcurrent Int         @default(10) @map("max_concurrent") @db.SmallInt
  activeTickets Int         @default(0) @map("active_tickets")
  skills        Json?
  createdAt     DateTime    @default(now()) @map("created_at")

  user          User        @relation(fields: [userId], references: [id])
  assignedTickets SupportTicket[]
  assignments   TicketAssignment[]
  escalationsFrom TicketEscalation[] @relation("EscFrom")
  escalationsTo   TicketEscalation[] @relation("EscTo")
  @@index([status])
  @@map("support_agents")
}

model SupportTicket {
  id              String         @id @default(uuid()) @db.Uuid
  ticketNumber    String         @unique @map("ticket_number")
  userId          String         @map("user_id") @db.Uuid
  categoryId      String?        @map("category_id") @db.Uuid
  rideId          String?        @map("ride_id") @db.Uuid
  subject         String
  description     String?
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(NORMAL)
  channel         TicketChannel  @default(APP)
  assignedAgentId String?        @map("assigned_agent_id") @db.Uuid
  firstResponseAt DateTime?      @map("first_response_at")
  slaDueAt        DateTime?      @map("sla_due_at")
  resolvedAt      DateTime?      @map("resolved_at")
  closedAt        DateTime?      @map("closed_at")
  reopenedCount   Int            @default(0) @map("reopened_count") @db.SmallInt
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id])
  category        SupportCategory? @relation(fields: [categoryId], references: [id])
  ride            Ride?            @relation(fields: [rideId], references: [id])
  assignedAgent   SupportAgent?    @relation(fields: [assignedAgentId], references: [id])
  messages        SupportTicketMessage[]
  assignments     TicketAssignment[]
  escalations     TicketEscalation[]
  @@index([userId])
  @@index([status])
  @@index([assignedAgentId])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id         String              @id @default(uuid()) @db.Uuid
  ticketId   String              @map("ticket_id") @db.Uuid
  authorType TicketMessageAuthor @map("author_type")
  authorId   String?             @map("author_id") @db.Uuid
  body       String
  isInternal Boolean             @default(false) @map("is_internal")
  attachments Json?
  createdAt  DateTime            @default(now()) @map("created_at")

  ticket     SupportTicket @relation(fields: [ticketId], references: [id])
  author     User?         @relation(fields: [authorId], references: [id])
  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

model TicketAssignment {
  id         String    @id @default(uuid()) @db.Uuid
  ticketId   String    @map("ticket_id") @db.Uuid
  agentId    String    @map("agent_id") @db.Uuid
  assignedBy String?   @map("assigned_by") @db.Uuid
  reason     String?
  status     String    @default("ACTIVE")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  releasedAt DateTime? @map("released_at")

  ticket     SupportTicket @relation(fields: [ticketId], references: [id])
  agent      SupportAgent  @relation(fields: [agentId], references: [id])
  @@index([ticketId])
  @@index([agentId])
  @@map("ticket_assignments")
}

model TicketEscalation {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @map("ticket_id") @db.Uuid
  fromAgentId String?  @map("from_agent_id") @db.Uuid
  toAgentId   String?  @map("to_agent_id") @db.Uuid
  level       Int      @default(1) @db.SmallInt
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  ticket      SupportTicket @relation(fields: [ticketId], references: [id])
  fromAgent   SupportAgent? @relation("EscFrom", fields: [fromAgentId], references: [id])
  toAgent     SupportAgent? @relation("EscTo", fields: [toAgentId], references: [id])
  @@index([ticketId])
  @@map("ticket_escalations")
}

model SupportCannedResponse {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String?  @map("category_id") @db.Uuid
  title      String
  body       String
  locale     String   @default("en")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  category   SupportCategory? @relation(fields: [categoryId], references: [id])
  @@map("support_canned_responses")
}




// ============================ IDENTITY ============================

model User {
  id              String    @id @default(uuid()) @db.Uuid
  phoneNumber     String    @unique @map("phone_number")
  email           String?   @unique
  passwordHash    String?   @map("password_hash")
  role            UserRole
  status          UserStatus @default(ACTIVE)
  isPhoneVerified Boolean   @default(false) @map("is_phone_verified")
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  profile         UserProfile?
  devices         UserDevice[]
  sessions        UserSession[]
  refreshTokens   RefreshToken[]
  emergencyContacts EmergencyContact[]
  savedPlaces     SavedPlace[]
  driver          Driver?
  customerRides   Ride[]    @relation("CustomerRides")
  promoRedemptions PromotionRedemption[]
  paymentMethods  PaymentInstrument[]
  customerWallet  CustomerWallet?
  paymentIntents  PaymentIntent[]
  paymentTransactions PaymentTransaction[]
  refunds         Refund[]
  walletTopups    WalletTopup[]
  cashbackGrants  CashbackGrant[]
  notifications   Notification[]
  notificationPreferences NotificationPreference[]
  inAppMessages   InAppMessage[]
  campaignRecipients CampaignRecipient[]
  chatParticipants ChatParticipant[]
  chatMessages    ChatMessage[]
  chatReadReceipts ChatReadReceipt[]
  chatBlocksMade  ChatBlock[] @relation("Blocker")
  chatBlocksReceived ChatBlock[] @relation("Blocked")
  chatReportsMade ChatReport[] @relation("Reporter")
  chatReportsReceived ChatReport[] @relation("Reported")
  customerRatingAggregate CustomerRatingAggregate?
  reviewFlagsRaised    ReviewFlag[] @relation("FlaggedBy")
  reviewFlagsModerated ReviewFlag[] @relation("Moderator")
  reviewResponses      ReviewResponse[]
  supportTickets       SupportTicket[]
  supportAgent         SupportAgent?
  ticketMessages       SupportTicketMessage[]
  referralCodes        ReferralCode[]
  referralsMade        Referral[] @relation("Referrer")
  referralsReceived    Referral[] @relation("Referee")
  referralRewards      ReferralReward[]
  referralFraudReviews ReferralFraudFlag[]
  assignedCoupons      Coupon[]
  roleAssignments      UserRoleAssignment[]
  adminActivityLogs    AdminActivityLog[]
  featureFlagOverrides FeatureFlagOverride[]
  adminSessions        AdminSession[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model UserProfile {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  firstName    String?   @map("first_name")
  lastName     String?   @map("last_name")
  dateOfBirth  DateTime? @map("date_of_birth") @db.Date
  gender       String?
  profileImage String?   @map("profile_image")
  languageCode String?   @default("en") @map("language_code")
  referralCode String?   @unique @map("referral_code")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user         User      @relation(fields: [userId], references: [id])
  @@map("user_profiles")
}

model UserDevice {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  deviceId    String?   @map("device_id")
  platform    AppPlatform?
  deviceName  String?   @map("device_name")
  appVersion  String?   @map("app_version")
  fcmToken    String?   @map("fcm_token")
  ipAddress   String?   @map("ip_address") @db.Inet
  deviceFingerprint String? @map("device_fingerprint")
  osVersion   String?   @map("os_version")
  isRooted    Boolean   @default(false) @map("is_rooted")
  isJailbroken Boolean  @default(false) @map("is_jailbroken")
  timezone    String?
  metadata    Json?
  lastSeenAt  DateTime? @map("last_seen_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User      @relation(fields: [userId], references: [id])
  sessions    UserSession[]
  refreshTokens RefreshToken[]
  deliveries  NotificationDelivery[]

  @@unique([userId, deviceId])
  @@map("user_devices")
}

model UserSession {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  deviceId       String?   @map("device_id") @db.Uuid
  accessTokenId  String?   @map("access_token_id") @db.Uuid
  refreshTokenId String?   @map("refresh_token_id") @db.Uuid
  ipAddress      String?   @map("ip_address") @db.Inet
  location       String?
  loginAt        DateTime  @default(now()) @map("login_at")
  logoutAt       DateTime? @map("logout_at")
  revokedReason  String?   @map("revoked_reason")
  endedBy        String?   @map("ended_by")
  expiresAt      DateTime  @map("expires_at")

  user           User        @relation(fields: [userId], references: [id])
  device         UserDevice? @relation(fields: [deviceId], references: [id])

  @@index([expiresAt])
  @@map("user_sessions")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  deviceId   String?   @map("device_id") @db.Uuid
  tokenHash  String    @map("token_hash")
  isRevoked  Boolean   @default(false) @map("is_revoked")
  revokedAt  DateTime? @map("revoked_at")
  revokedReason String? @map("revoked_reason")
  rotatedFrom String?  @map("rotated_from") @db.Uuid
  rotatedTo   String?  @map("rotated_to") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id])
  device     UserDevice? @relation(fields: [deviceId], references: [id])
  rotatedFromToken RefreshToken?  @relation("TokenRotation", fields: [rotatedFrom], references: [id])
  rotatedToTokens  RefreshToken[] @relation("TokenRotation")

  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OtpVerification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  phoneNumber String    @map("phone_number")
  otpHash     String    @map("otp_hash")
  purpose     OtpPurpose
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  isVerified  Boolean   @default(false) @map("is_verified")
  verifiedAt  DateTime? @map("verified_at")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([phoneNumber])
  @@index([purpose])
  @@map("otp_verifications")
}

model EmergencyContact {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  contactName String   @map("contact_name")
  phoneNumber String   @map("phone_number")
  relationship String?
  priority    Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id])
  @@map("emergency_contacts")
}

model SavedPlace {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  label     String
  address   String?
  buildingName String? @map("building_name")
  landmark  String?
  floor     String?
  instructions String?
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  location  Unsupported("geography(Point,4326)")?
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id])
  @@map("saved_places")
}




// ============================ VEHICLE ============================

model VehicleType {
  id                 String   @id @default(uuid()) @db.Uuid
  code               String   @unique
  name               String
  passengerCapacity  Int?     @map("passenger_capacity") @db.SmallInt
  luggageCapacity    Int?     @map("luggage_capacity") @db.SmallInt
  minimumFare        Decimal? @map("minimum_fare") @db.Decimal(10, 2)
  baseFare           Decimal? @map("base_fare") @db.Decimal(10, 2)
  perKmRate          Decimal? @map("per_km_rate") @db.Decimal(10, 2)
  perMinuteRate      Decimal? @map("per_minute_rate") @db.Decimal(10, 2)
  waitingCharge      Decimal? @map("waiting_charge") @db.Decimal(10, 2)
  cancellationCharge Decimal? @map("cancellation_charge") @db.Decimal(10, 2)
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")

  vehicles           Vehicle[]
  rideRequests       RideRequest[]
  rides              Ride[]
  pricingRules       PricingRule[]
  surgeWindows       SurgeWindow[]
  promotions         Promotion[]
  @@map("vehicle_types")
}

model Vehicle {
  id                  String   @id @default(uuid()) @db.Uuid
  registrationNumber  String   @unique @map("registration_number")
  registrationState   String?  @map("registration_state")
  vin                 String?  @unique
  make                String?
  model               String?
  manufacturingYear   Int?     @map("manufacturing_year") @db.SmallInt
  color               String?
  fuelType            String?  @map("fuel_type")
  seatingCapacity     Int?     @map("seating_capacity") @db.SmallInt
  vehicleTypeId       String   @map("vehicle_type_id") @db.Uuid
  ownerName           String?  @map("owner_name")
  ownerPhone          String?  @map("owner_phone")
  currentOdometer     Int?     @map("current_odometer")
  currentDriverId     String?  @map("current_driver_id") @db.Uuid
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  vehicleType         VehicleType @relation(fields: [vehicleTypeId], references: [id])
  documents           VehicleDocument[]
  images              VehicleImage[]
  inspections         VehicleInspection[]
  maintenanceLogs     MaintenanceLog[]
  fuelLogs            FuelLog[]
  insuranceClaims     InsuranceClaim[]
  assignments         VehicleAssignment[]
  dispatches          RideDispatch[]
  rides               Ride[]

  @@index([vehicleTypeId])
  @@index([isActive])
  @@map("vehicles")
}

model VehicleAssignment {
  id         String    @id @default(uuid()) @db.Uuid
  driverId   String    @map("driver_id") @db.Uuid
  vehicleId  String    @map("vehicle_id") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at")
  releasedAt DateTime? @map("released_at")
  reason     String?
  assignedBy String?   @map("assigned_by") @db.Uuid
  status     String    @default("ACTIVE")
  createdAt  DateTime  @default(now()) @map("created_at")

  driver     Driver    @relation(fields: [driverId], references: [id])
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id])
  @@index([driverId])
  @@index([vehicleId])
  @@map("vehicle_assignments")
}

model VehicleDocument {
  id                 String    @id @default(uuid()) @db.Uuid
  vehicleId          String    @map("vehicle_id") @db.Uuid
  documentType       String    @map("document_type")
  documentNumber     String?   @map("document_number")
  fileUrl            String    @map("file_url")
  issuedAt           DateTime? @map("issued_at") @db.Date
  expiresAt          DateTime? @map("expires_at") @db.Date
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  createdAt          DateTime  @default(now()) @map("created_at")

  vehicle            Vehicle   @relation(fields: [vehicleId], references: [id])
  @@index([vehicleId])
  @@index([expiresAt])
  @@map("vehicle_documents")
}

model VehicleImage {
  id         String   @id @default(uuid()) @db.Uuid
  vehicleId  String   @map("vehicle_id") @db.Uuid
  imageType  String   @map("image_type")
  imageUrl   String   @map("image_url")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  @@index([vehicleId])
  @@map("vehicle_images")
}

model VehicleInspection {
  id          String   @id @default(uuid()) @db.Uuid
  vehicleId   String   @map("vehicle_id") @db.Uuid
  inspectedBy String?  @map("inspected_by") @db.Uuid
  inspectedAt DateTime @default(now()) @map("inspected_at")
  checklist   Json?
  result      String   // PASSED | FAILED | REPAIR_REQUIRED
  notes       String?

  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  @@index([vehicleId])
  @@map("vehicle_inspections")
}

model MaintenanceLog {
  id          String    @id @default(uuid()) @db.Uuid
  vehicleId   String    @map("vehicle_id") @db.Uuid
  serviceDate DateTime  @map("service_date") @db.Date
  workshop    String?
  description String?
  cost        Decimal?  @db.Decimal(10, 2)
  odometer    Int?
  nextDueDate DateTime? @map("next_due_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")

  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id])
  @@index([vehicleId])
  @@map("maintenance_logs")
}

model FuelLog {
  id          String   @id @default(uuid()) @db.Uuid
  vehicleId   String   @map("vehicle_id") @db.Uuid
  fuelAmount  Decimal? @map("fuel_amount") @db.Decimal(8, 2)
  fuelCost    Decimal? @map("fuel_cost") @db.Decimal(10, 2)
  fuelStation String?  @map("fuel_station")
  odometer    Int?
  loggedAt    DateTime @map("logged_at") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  @@index([vehicleId])
  @@map("fuel_logs")
}

model InsuranceClaim {
  id               String    @id @default(uuid()) @db.Uuid
  vehicleId        String    @map("vehicle_id") @db.Uuid
  claimNumber      String?   @map("claim_number")
  insuranceCompany String?   @map("insurance_company")
  status           String?
  amount           Decimal?  @db.Decimal(12, 2)
  accidentDate     DateTime? @map("accident_date") @db.Date
  settlementDate   DateTime? @map("settlement_date") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at")

  vehicle          Vehicle   @relation(fields: [vehicleId], references: [id])
  @@index([vehicleId])
  @@map("insurance_claims")
}

// NOTE: accident_reports references rides(id) via raw SQL FK; modeled loosely.
model AccidentReport {
  id           String    @id @default(uuid()) @db.Uuid
  vehicleId    String    @map("vehicle_id") @db.Uuid
  driverId     String?   @map("driver_id") @db.Uuid
  rideId       String?   @map("ride_id") @db.Uuid
  policeReport String?   @map("police_report")
  description  String?
  location     Unsupported("geography(Point,4326)")?
  images       Json?
  witnesses    Json?
  occurredAt   DateTime? @map("occurred_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([vehicleId])
  @@index([driverId])
  @@map("accident_reports")
}




// ============================ WALLET (operations) ============================
// Polymorphic (walletType, walletId) fields are plain scalars: they can point at
// customer_wallets OR driver_wallets, so no single Prisma relation is modeled.

model WalletTopup {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  walletId             String    @map("wallet_id") @db.Uuid
  amount               Decimal   @db.Decimal(12, 2)
  currency             String    @default("INR") @db.Char(3)
  paymentIntentId      String?   @map("payment_intent_id") @db.Uuid
  paymentTransactionId String?   @map("payment_transaction_id") @db.Uuid
  status               String    @default("PENDING")
  gateway              String?
  idempotencyKey       String    @unique @map("idempotency_key")
  createdAt            DateTime  @default(now()) @map("created_at")
  completedAt          DateTime? @map("completed_at")

  user                 User           @relation(fields: [userId], references: [id])
  wallet               CustomerWallet @relation(fields: [walletId], references: [id])
  @@index([walletId])
  @@index([userId])
  @@map("wallet_topups")
}

model WithdrawalRequest {
  id              String    @id @default(uuid()) @db.Uuid
  driverId        String    @map("driver_id") @db.Uuid
  walletId        String    @map("wallet_id") @db.Uuid
  bankAccountId   String?   @map("bank_account_id") @db.Uuid
  amount          Decimal   @db.Decimal(12, 2)
  status          String    @default("REQUESTED")
  payoutId        String?   @map("payout_id") @db.Uuid
  rejectionReason String?   @map("rejection_reason")
  requestedAt     DateTime  @default(now()) @map("requested_at")
  processedAt     DateTime? @map("processed_at")

  driver          Driver             @relation(fields: [driverId], references: [id])
  wallet          DriverWallet       @relation(fields: [walletId], references: [id])
  bankAccount     DriverBankAccount? @relation(fields: [bankAccountId], references: [id])
  @@index([driverId])
  @@index([status])
  @@map("withdrawal_requests")
}

model WalletHold {
  id            String    @id @default(uuid()) @db.Uuid
  walletType    String    @map("wallet_type")
  walletId      String    @map("wallet_id") @db.Uuid
  ownerId       String    @map("owner_id") @db.Uuid
  amount        Decimal   @db.Decimal(12, 2)
  reason        String?
  status        String    @default("ACTIVE")
  referenceType String?   @map("reference_type")
  referenceId   String?   @map("reference_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  releasedAt    DateTime? @map("released_at")

  @@index([walletType, walletId])
  @@map("wallet_holds")
}

model WalletTransfer {
  id             String   @id @default(uuid()) @db.Uuid
  fromWalletType String   @map("from_wallet_type")
  fromWalletId   String?  @map("from_wallet_id") @db.Uuid
  toWalletType   String   @map("to_wallet_type")
  toWalletId     String?  @map("to_wallet_id") @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  reason         String?
  status         String   @default("COMPLETED")
  ledgerGroup    String?  @map("ledger_group") @db.Uuid
  idempotencyKey String   @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("wallet_transfers")
}

model CashbackCampaign {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  name         String?
  triggerEvent String   @map("trigger_event")
  rewardType   String   @map("reward_type")
  rewardValue  Decimal  @map("reward_value") @db.Decimal(10, 2)
  maxReward    Decimal? @map("max_reward") @db.Decimal(10, 2)
  minAmount    Decimal  @default(0) @map("min_amount") @db.Decimal(10, 2)
  totalBudget  Decimal? @map("total_budget") @db.Decimal(14, 2)
  usedBudget   Decimal  @default(0) @map("used_budget") @db.Decimal(14, 2)
  validFrom    DateTime @map("valid_from")
  validTo      DateTime @map("valid_to")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  grants       CashbackGrant[]
  @@index([isActive, validFrom, validTo])
  @@map("cashback_campaigns")
}

model CashbackGrant {
  id          String    @id @default(uuid()) @db.Uuid
  campaignId  String    @map("campaign_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  walletType  String    @default("CUSTOMER") @map("wallet_type")
  walletId    String?   @map("wallet_id") @db.Uuid
  rideId      String?   @map("ride_id") @db.Uuid
  amount      Decimal   @db.Decimal(10, 2)
  status      String    @default("PENDING")
  grantedAt   DateTime  @default(now()) @map("granted_at")
  creditedAt  DateTime? @map("credited_at")
  expiresAt   DateTime? @map("expires_at")

  campaign    CashbackCampaign @relation(fields: [campaignId], references: [id])
  user        User             @relation(fields: [userId], references: [id])
  ride        Ride?            @relation(fields: [rideId], references: [id])
  @@index([campaignId])
  @@index([userId])
  @@map("cashback_grants")
}

model WalletAdjustment {
  id          String    @id @default(uuid()) @db.Uuid
  walletType  String    @map("wallet_type")
  walletId    String    @map("wallet_id") @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  direction   String    // CREDIT | DEBIT
  amount      Decimal   @db.Decimal(12, 2)
  reason      String
  requestedBy String?   @map("requested_by") @db.Uuid
  approvedBy  String?   @map("approved_by") @db.Uuid
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now()) @map("created_at")
  appliedAt   DateTime? @map("applied_at")

  @@index([walletType, walletId])
  @@index([status])
  @@map("wallet_adjustments")
}

model WalletReconciliation {
  id              String   @id @default(uuid()) @db.Uuid
  walletType      String   @map("wallet_type")
  walletId        String   @map("wallet_id") @db.Uuid
  asOf            DateTime @map("as_of")
  storedBalance   Decimal  @map("stored_balance") @db.Decimal(14, 2)
  computedBalance Decimal  @map("computed_balance") @db.Decimal(14, 2)
  difference      Decimal  @db.Decimal(14, 2)
  status          String   // MATCHED | MISMATCH
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([walletType, walletId, asOf])
  @@map("wallet_reconciliations")
}




